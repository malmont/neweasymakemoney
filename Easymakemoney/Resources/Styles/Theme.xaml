<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:converters="clr-namespace:Easymakemoney.Converters">

    <converters:DecimalInputConverter x:Key="DecimalInput" />

    <!-- Valeurs par défaut : SiteBrandingService les remplace par celles du site (app-theme). -->
    <Color x:Key="ThemePrimary">#512BD4</Color>
    <Color x:Key="ThemePrimaryTint">#18512BD4</Color>
    <Color x:Key="ThemeOnPrimary">#FFFFFF</Color>
    <x:Double x:Key="ThemeCardRadius">16</x:Double>
    <x:Double x:Key="ThemeButtonRadius">14</x:Double>

    <Color x:Key="UiBackground">#F4F6F9</Color>
    <Color x:Key="UiSurface">#FFFFFF</Color>
    <Color x:Key="UiBorder">#E2E8F0</Color>
    <Color x:Key="UiTextPrimary">#0F172A</Color>
    <Color x:Key="UiTextSecondary">#475569</Color>
    <Color x:Key="UiTextMuted">#64748B</Color>

    <Style x:Key="UiPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource UiBackground}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style x:Key="UiCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
        <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="UiH1" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
    </Style>

    <Style x:Key="UiTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
    </Style>

    <Style x:Key="UiBody" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{StaticResource UiTextSecondary}" />
    </Style>

    <Style x:Key="UiIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="Aspect" Value="None" />
    </Style>
</ResourceDictionary>
