<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:handlers="clr-namespace:Easymakemoney.Handlers"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:Class="Easymakemoney.Views.Startup.LoginPage"
             x:Name="LoginRoot"
             Style="{StaticResource UiPage}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Title="Connexion">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DataTemplates/CollectionFormTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,24" Spacing="20" VerticalOptions="Center">

            <!-- Identité du site -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border WidthRequest="64" HeightRequest="64" HorizontalOptions="Center"
                        BackgroundColor="{DynamicResource ThemePrimaryTint}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Grid>
                        <Label Text="{Binding Branding.Initial, Source={x:Reference LoginRoot}}"
                               IsVisible="{Binding Branding.HasNoLogo, Source={x:Reference LoginRoot}}"
                               FontFamily="InterBold" FontSize="26" TextColor="{DynamicResource ThemePrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Grid IsVisible="{Binding Branding.HasLogo, Source={x:Reference LoginRoot}}"
                              BackgroundColor="{StaticResource UiSurface}" Padding="4">
                            <Image Source="{Binding Branding.LogoUrl, Source={x:Reference LoginRoot}}" Aspect="AspectFit" />
                        </Grid>
                    </Grid>
                </Border>
                <Label Text="{Binding Branding.SiteName, Source={x:Reference LoginRoot}}" Style="{StaticResource UiTitle}"
                       HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <components:UiCard Style="{StaticResource UiCard}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bienvenue" Style="{StaticResource UiH1}" HorizontalTextAlignment="Center" />
                        <Label Text="Connexion à votre compte" Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Message d'erreur -->
                    <Border IsVisible="{Binding HasErrorMessage}"
                            BackgroundColor="#FDE8E8"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Label Text="{Binding ErrorMessage}" FontFamily="Inter" FontSize="14" TextColor="#B91C1C" HorizontalTextAlignment="Center" />
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" HeightRequest="30" WidthRequest="30" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Adresse e-mail" Style="{StaticResource FormLabel}" />
                        <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                            <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="Adresse e-mail" Keyboard="Email" Text="{Binding Email}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mot de passe" Style="{StaticResource FormLabel}" />
                        <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                            <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="Mot de passe" IsPassword="True" Text="{Binding Password}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Button.CornerRadius est un int : le rayon du thème (double) passe par UiCard. -->
                    <components:UiCard Radius="{DynamicResource ThemeButtonRadius}"
                                       BackgroundColor="{DynamicResource ThemePrimary}"
                                       StrokeThickness="0"
                                       Padding="0"
                                       Margin="0,4,0,0">
                        <Button Text="Se connecter"
                                Command="{Binding LoginCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource ThemeOnPrimary}"
                                FontFamily="InterSemiBold"
                                FontSize="16"
                                HeightRequest="52" />
                    </components:UiCard>
                </VerticalStackLayout>
            </components:UiCard>

            <Button Text="Changer de site"
                    Command="{Binding ChangeSiteCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource ThemePrimary}"
                    FontFamily="InterMedium"
                    FontSize="15"
                    MinimumHeightRequest="44"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
