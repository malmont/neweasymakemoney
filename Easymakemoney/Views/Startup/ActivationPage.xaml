<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:handlers="clr-namespace:Easymakemoney.Handlers"
             xmlns:vm="clr-namespace:Easymakemoney.ViewModels.Startup"
             x:Class="Easymakemoney.Views.Startup.ActivationPage"
             x:DataType="vm:ActivationPageViewModel"
             Shell.NavBarIsVisible="False"
             Title="Choix du site">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30,40" VerticalOptions="Center">

            <Image Source="logo.png" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Configuration du site" FontSize="24" FontAttributes="Bold" TextColor="#512BD4" HorizontalTextAlignment="Center" />
                <Label Text="Activez votre appareil ou saisissez le code de votre site pour commencer."
                       FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Message d'erreur -->
            <Border IsVisible="{Binding HasErrorMessage}"
                    BackgroundColor="#FDE8E8"
                    Stroke="#F87171"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">
                <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="14" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Indicateur d'activité -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4" HeightRequest="30" WidthRequest="30" />

            <!-- Carte de confirmation ("C'est bien ça ?") -->
            <Border IsVisible="{Binding IsConfirming}"
                    Stroke="#512BD4"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F5F3FF"
                    Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Confirmation du site" FontSize="18" FontAttributes="Bold" TextColor="#512BD4" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding CandidateTenant.Name}" FontSize="20" FontAttributes="Bold" TextColor="#1F2937" HorizontalTextAlignment="Center" />
                    <Label Text="C'est bien ça ?" FontSize="16" TextColor="#4B5563" HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Non"
                                Command="{Binding CancelConfirmationCommand}"
                                BackgroundColor="#9CA3AF"
                                TextColor="White"
                                CornerRadius="8"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Grid.Column="1" Text="Oui"
                                Command="{Binding ConfirmTenantCommand}"
                                BackgroundColor="#512BD4"
                                TextColor="White"
                                CornerRadius="8"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Formulaire de saisie (masqué pendant la confirmation) -->
            <VerticalStackLayout IsVisible="{Binding IsConfirming, Converter={StaticResource InvertedBoolConverter}}" Spacing="25">

                <!-- Zone 1 : Clé d'activation -->
                <Border Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Clé d'activation" FontSize="16" FontAttributes="Bold" TextColor="#374151" />
                        <Label Text="Format : IZ-ADM-XXXX-XXXX-XXXX" FontSize="12" TextColor="Gray" />
                        <Border HeightRequest="45"
                                Padding="10,0"
                                Stroke="#D1D5DB"
                                StrokeShape="RoundRectangle 8">
                            <handlers:BorderlessEntry Placeholder="IZ-ADM-..."
                                                      Text="{Binding KeyInput}"
                                                      VerticalOptions="Center" />
                        </Border>
                        <Button Text="Valider la clé"
                                Command="{Binding ValidateKeyCommand}"
                                BackgroundColor="#512BD4"
                                TextColor="White"
                                CornerRadius="8"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Zone 2 : Code du site (bien visible pour demo / code court) -->
                <Border Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Code du site" FontSize="16" FontAttributes="Bold" TextColor="#374151" />
                        <Label Text="Code de votre site (ex. ABC-D4F) ou domaine" FontSize="12" TextColor="Gray" />
                        <Border HeightRequest="45"
                                Padding="10,0"
                                Stroke="#D1D5DB"
                                StrokeShape="RoundRectangle 8">
                            <handlers:BorderlessEntry Placeholder="ex. ABC-D4F"
                                                      Text="{Binding SiteCodeInput}"
                                                      VerticalOptions="Center" />
                        </Border>
                        <Button Text="Valider le code"
                                Command="{Binding ValidateSiteCodeCommand}"
                                BackgroundColor="#512BD4"
                                TextColor="White"
                                CornerRadius="8"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
