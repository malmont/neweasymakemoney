<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:ListNewProductViewModel"
             x:Class="Easymakemoney.Views.Lists.ListNewProductPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Produits">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Produits" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding ListProducts}" SelectionMode="None" Margin="16,8,16,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="24,80">
                    <Label Text="Aucun produit" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Touchez + pour en créer un." Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x1:ListProduct">
                    <SwipeView Margin="0,0,0,10">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Supprimer" BackgroundColor="#B91C1C"
                                           Command="{Binding Path=BindingContext.DeleteProductCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedProductsVariants, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource UiBorder}" VerticalOptions="Center">
                                    <Image Source="{Binding image}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding name}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding quantity, StringFormat='Stock : {0}'}" Style="{StaticResource UiBody}" />
                                    <Label Text="{Binding price, StringFormat='Prix : {0}', Converter={StaticResource CurrencyConverter}}"
                                           FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource ThemePrimary}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                        </components:UiCard>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1" WidthRequest="60" HeightRequest="60" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                BackgroundColor="{DynamicResource ThemePrimary}" HorizontalOptions="End" VerticalOptions="End" Margin="16,0,16,28"
                SemanticProperties.Description="Ajouter un produit">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShowBottomSheetCommand}" />
            </Border.GestureRecognizers>
            <Path Data="M12 5v14M5 12h14" Stroke="{DynamicResource ThemeOnPrimary}" StrokeThickness="2.4" StrokeLineCap="Round"
                  WidthRequest="24" HeightRequest="24" Aspect="None" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
