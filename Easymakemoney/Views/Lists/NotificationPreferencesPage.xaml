<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:NotificationPreferencesViewModel"
             x:Class="Easymakemoney.Views.Lists.NotificationPreferencesPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Notifications">

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Notifications" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Choisissez combien de courriels de suivi vous recevez (commandes à expédier, résumés…). Les courriels indispensables (mot de passe, invitations, confirmations) partent toujours." Style="{StaticResource UiBody}" FontSize="13" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" HeightRequest="24" />

                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Choices}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationLevelChoice">
                            <Border StrokeShape="RoundRectangle 12" Padding="14,10" StrokeThickness="1" Stroke="{StaticResource UiBorder}" BackgroundColor="{StaticResource UiSurface}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectLevelCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="15" TextColor="{StaticResource UiTextPrimary}" />
                                    <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" Style="{StaticResource UiBody}" FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding Preferences.CapText}" Style="{StaticResource UiBody}" FontSize="12" />
                <Label Text="{Binding Preferences.HeldText}" IsVisible="{Binding Preferences.HasHeld}" FontFamily="InterSemiBold" FontSize="12" TextColor="#B45309" />

                <Button Text="Avancé : chaque type de notification" Command="{Binding ToggleAdvancedCommand}" HeightRequest="40" CornerRadius="12"
                        FontFamily="InterSemiBold" FontSize="13" BackgroundColor="{StaticResource UiSurface}" TextColor="{DynamicResource ThemePrimary}"
                        BorderColor="{DynamicResource ThemePrimary}" BorderWidth="1" />
                <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowAdvanced}" BindableLayout.ItemsSource="{Binding Kinds}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationKind">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding label}" Style="{StaticResource UiBody}" FontSize="14" />
                                    <Label Text="{Binding ChannelText}" Style="{StaticResource UiBody}" FontSize="11" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding enabled, Mode=OneWay}" OnColor="{DynamicResource ThemePrimary}" InputTransparent="True" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.ToggleKindCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
