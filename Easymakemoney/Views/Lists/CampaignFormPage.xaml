<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:handlers="clr-namespace:Easymakemoney.Handlers"
             x:DataType="list:CampaignFormViewModel"
             x:Class="Easymakemoney.Views.Lists.CampaignFormPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Campagne">

    <ContentPage.Resources>
        <!-- Mêmes styles que DocumentReadPage : ils ne sont pas globaux -->
        <Style x:Key="FormDate" TargetType="handlers:BorderlessDatePicker">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="InterMedium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource UiTextSecondary}" />
        </Style>
        <Style x:Key="FormField" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="FormEntry" TargetType="handlers:BorderlessEntry">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource UiTextMuted}" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>
        <Style x:Key="FormPicker" TargetType="Picker">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
            <Setter Property="TitleColor" Value="{StaticResource UiTextMuted}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>
        <Style x:Key="DocAction" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimaryTint}" />
            <Setter Property="TextColor" Value="{DynamicResource ThemePrimary}" />
            <Setter Property="FontFamily" Value="InterBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="DocMain" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimary}" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeOnPrimary}" />
            <Setter Property="FontFamily" Value="InterBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="52" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="{Binding PageTitle}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Campagne impossible à ouvrir -->
                <VerticalStackLayout IsVisible="{Binding HasLoadError}" Spacing="12">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#FEE2E2" Padding="12,10">
                        <Label Text="{Binding LoadError}" FontFamily="InterSemiBold" FontSize="14" TextColor="#B91C1C" />
                    </Border>
                    <Button Text="Réessayer" Command="{Binding ReloadCommand}" Style="{StaticResource DocAction}" />
                </VerticalStackLayout>

                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" />

                <VerticalStackLayout IsVisible="{Binding IsLoaded}" Spacing="12">
                    <!-- Facture de la régie -->
                    <VerticalStackLayout IsVisible="{Binding CanReadInvoice}" Spacing="6">
                        <Button Text="Lire la facture de la régie" Command="{Binding ReadInvoiceCommand}" Style="{StaticResource DocAction}" />
                        <Label Text="Photo ou PDF : le montant, la date et le nom sont repris, et la facture est jointe à la campagne."
                               Style="{StaticResource UiBody}" FontSize="13" />
                    </VerticalStackLayout>
                    <Border IsVisible="{Binding HasDocumentText}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource ThemePrimaryTint}" Padding="12,10">
                        <Label Text="{Binding DocumentText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource ThemePrimary}" />
                    </Border>
                    <Border IsVisible="{Binding HasRemarks}" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#FEF3C7" Padding="12,10">
                        <Label Text="{Binding RemarksText}" FontFamily="InterSemiBold" FontSize="14" TextColor="#B45309" />
                    </Border>

                    <Label Text="Nom de la campagne" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                        <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="Ex. : Soldes d'hiver Facebook" Text="{Binding Name}" />
                    </Border>

                    <Label Text="Canal" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                        <Picker Style="{StaticResource FormPicker}" Title="Choisir un canal"
                                ItemsSource="{Binding Channels}"
                                SelectedItem="{Binding SelectedChannel}"
                                ItemDisplayBinding="{Binding Label, x:DataType=x1:CampaignChannelChoice}" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Label Text="Début" Style="{StaticResource FormLabel}" />
                        <Label Grid.Column="1" Text="Fin" Style="{StaticResource FormLabel}" />
                        <Border Grid.Row="1" Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                            <handlers:BorderlessDatePicker Style="{StaticResource FormDate}" Date="{Binding StartDate}" Format="dd/MM/yyyy" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                            <handlers:BorderlessDatePicker Style="{StaticResource FormDate}" Date="{Binding EndDate}" MinimumDate="{Binding StartDate}" Format="dd/MM/yyyy" />
                        </Border>
                    </Grid>
                    <Label Text="La campagne est comptée dans la période de sa date de début." Style="{StaticResource UiBody}" FontSize="13" />

                    <Label Text="Devise" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                        <Picker Style="{StaticResource FormPicker}" Title="Choisir une devise" ItemsSource="{Binding CurrencyChoices}" SelectedItem="{Binding SelectedCurrency}" />
                    </Border>

                    <Label Text="{Binding AmountLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                        <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="0,00" Keyboard="Numeric" Text="{Binding AmountText}" />
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding NeedsExchangeRate}" Spacing="12">
                        <Label Text="{Binding ExchangeRateLabel}" Style="{StaticResource FormLabel}" />
                        <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                            <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="Ex. : 1,35" Keyboard="Numeric" Text="{Binding ExchangeRateText}" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="Notes (facultatif)" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                        <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="Public visé, message, code promo…" Text="{Binding Notes}" />
                    </Border>

                    <!-- Ciblage facultatif d'articles -->
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Cibler des articles" Style="{StaticResource UiTitle}" FontSize="15" />
                                    <Label Text="{Binding TargetSummary}" Style="{StaticResource UiBody}" FontSize="13" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsTargeting}" OnColor="{DynamicResource ThemePrimary}" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding IsTargeting}" Spacing="8">
                                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding TargetProducts}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="list:CampaignTargetProduct">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding Name}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}"
                                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                <Button Grid.Column="1" Text="Retirer" BackgroundColor="Transparent" TextColor="#B91C1C"
                                                        FontFamily="InterSemiBold" FontSize="14" HeightRequest="40" Padding="8,0"
                                                        Command="{Binding Path=BindingContext.RemoveTargetCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                                    <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="Rechercher un nom, un code…"
                                                              ReturnType="Search" ClearButtonVisibility="WhileEditing" Text="{Binding ProductSearchText}" />
                                </Border>
                                <Label Text="{Binding SearchStatusText}" Style="{StaticResource UiBody}" FontSize="13" />

                                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding SearchResults}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x1:AvailableProduct">
                                            <Border StrokeThickness="1" Stroke="{StaticResource UiBorder}" StrokeShape="RoundRectangle 12" Padding="10,8"
                                                    BackgroundColor="{StaticResource UiSurface}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.ToggleProductCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*,28" ColumnSpacing="10">
                                                    <components:UiThumb Source="{Binding image}" Icon="M20 12l-8 8-9-9V3h8l9 9zM7.5 7.5h.01" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding name}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding PriceText}" Style="{StaticResource UiBody}" FontSize="13" />
                                                    </VerticalStackLayout>
                                                    <Border Grid.Column="2" IsVisible="{Binding IsSelected}" WidthRequest="28" HeightRequest="28" StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 14" VerticalOptions="Center" BackgroundColor="{DynamicResource ThemePrimary}">
                                                        <Path Data="M6 12l4 4 8-8" Stroke="{DynamicResource ThemeOnPrimary}" StrokeThickness="2.4" StrokeLineCap="Round"
                                                              StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24" Aspect="None"
                                                              HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>

                    <Border IsVisible="{Binding HasCommandes}" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource ThemePrimaryTint}" Padding="12,10">
                        <Label Text="{Binding CommandesText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource ThemePrimary}" />
                    </Border>

                    <Button Text="Enregistrer la campagne" Command="{Binding SaveCommand}" Style="{StaticResource DocMain}" Margin="0,8,0,24" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
