<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:stats="clr-namespace:Easymakemoney.ViewModels.Statistiques"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:SupportTicketViewModel"
             x:Class="Easymakemoney.Views.Lists.SupportTicketPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Demande d'assistance">

    <ContentPage.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
        </Style>
        <Style x:Key="ActionLink" TargetType="Label">
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource ThemePrimary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Demande d'assistance" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" HeightRequest="24" />

                <!-- En-tête : objet, état, client, délai -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="16" IsVisible="{Binding HasTicket}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Ticket.subject}" Style="{StaticResource UiTitle}" FontSize="17" />
                        <Label Text="{Binding Ticket.HeaderText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource ThemePrimary}" />
                        <Label Text="{Binding Ticket.CustomerText}" Style="{StaticResource UiBody}" FontSize="13" />
                        <Label Text="{Binding Ticket.ChannelText}" Style="{StaticResource UiBody}" FontSize="12" />
                        <Label Text="{Binding Ticket.DueText}" IsVisible="{Binding Ticket.HasDue}" FontFamily="InterMedium" FontSize="12" TextColor="{StaticResource UiTextSecondary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Ticket.overdue}" Value="True">
                                    <Setter Property="TextColor" Value="#B91C1C" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding Ticket.AssignedText}" Style="{StaticResource UiBody}" FontSize="12" />
                        <HorizontalStackLayout Spacing="18" Margin="0,8,0,0">
                            <Label Text="Changer l'état" Style="{StaticResource ActionLink}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeStatusCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="Priorité" Style="{StaticResource ActionLink}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangePriorityCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding AssignText}" Style="{StaticResource ActionLink}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleAssignCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </components:UiCard>

                <!-- Commande ou vente liée, en lecture -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="16" IsVisible="{Binding Ticket.HasOrder}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Commande liée" Style="{StaticResource UiTitle}" FontSize="15" />
                        <Label Text="{Binding Ticket.orderSummary.TitleText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource ThemePrimary}" />
                        <Label Text="{Binding Ticket.orderSummary.LinesText}" Style="{StaticResource UiBody}" FontSize="13" />
                        <Label Text="{Binding Ticket.orderSummary.TotalText}" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                        <Label Text="{Binding Ticket.orderSummary.PaymentsText}" IsVisible="{Binding Ticket.orderSummary.HasPayments}" Style="{StaticResource UiBody}" FontSize="12" />
                        <Label Text="{Binding Ticket.orderSummary.ReturnsText}" IsVisible="{Binding Ticket.orderSummary.HasReturns}" Style="{StaticResource UiBody}" FontSize="12" />
                        <Label Text="{Binding Ticket.orderSummary.ShippingText}" IsVisible="{Binding Ticket.orderSummary.HasShipping}" Style="{StaticResource UiBody}" FontSize="12" />
                    </VerticalStackLayout>
                </components:UiCard>

                <!-- Fil des messages -->
                <Label Text="Échanges" Style="{StaticResource UiTitle}" FontSize="16" IsVisible="{Binding HasTicket}" Margin="0,6,0,0" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Messages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SupportMessage">
                            <Border StrokeThickness="1" Stroke="{StaticResource UiBorder}" StrokeShape="RoundRectangle 14" Padding="14,10" BackgroundColor="{StaticResource UiSurface}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsInternal}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                        <Setter Property="Stroke" Value="#F59E0B" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCustomer}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimaryTint}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding AuthorText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource UiTextPrimary}" />
                                        <Label Grid.Column="1" Text="{Binding WhenText}" Style="{StaticResource UiBody}" FontSize="11" />
                                    </Grid>
                                    <Label Text="{Binding body}" FontFamily="Inter" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                    <Label Text="{Binding AttachmentsText, StringFormat='Pièces jointes : {0}'}" IsVisible="{Binding HasAttachments}" Style="{StaticResource UiBody}" FontSize="12" />
                                    <Label Text="{Binding KindText}" IsVisible="{Binding HasKind}" FontFamily="InterMedium" FontSize="11" TextColor="{StaticResource UiTextSecondary}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEmailFailed}" Value="True">
                                                <Setter Property="TextColor" Value="#B91C1C" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Réponse -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="16" IsVisible="{Binding CanReply}" Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="10">
                        <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-8" BindableLayout.ItemsSource="{Binding Modes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="stats:StatsChoice">
                                    <Border Style="{StaticResource Chip}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimary}" />
                                                <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectModeCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding Code}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource UiTextPrimary}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource ThemeOnPrimary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding ReplyHint}" Style="{StaticResource UiBody}" FontSize="12" />
                        <Border StrokeThickness="1" Stroke="{StaticResource UiBorder}" StrokeShape="RoundRectangle 12" Padding="10,4" BackgroundColor="{StaticResource UiSurface}">
                            <Editor Text="{Binding ReplyText}" Placeholder="Votre message" AutoSize="TextChanges" MinimumHeightRequest="96"
                                    FontFamily="Inter" FontSize="15" TextColor="{StaticResource UiTextPrimary}" PlaceholderColor="{StaticResource UiTextMuted}" BackgroundColor="Transparent" />
                        </Border>
                        <Button Text="{Binding SendText}" Command="{Binding SendCommand}" HeightRequest="48" CornerRadius="14"
                                FontFamily="InterSemiBold" FontSize="15" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="{DynamicResource ThemeOnPrimary}" />
                    </VerticalStackLayout>
                </components:UiCard>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
