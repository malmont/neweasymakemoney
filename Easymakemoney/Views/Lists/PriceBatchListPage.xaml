<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:PriceBatchListViewModel"
             x:Class="Easymakemoney.Views.Lists.PriceBatchListPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Changements de prix">

    <Grid RowDefinitions="Auto,Auto,*">
        <components:AppHeader Title="Changements de prix" />

        <Label Grid.Row="1" Padding="16,12,16,0" Style="{StaticResource UiBody}" FontSize="13"
               Text="Chaque changement de prix fait depuis l'application peut être annulé pendant 24 h." />

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsEmpty}" VerticalOptions="Center" Spacing="8" Padding="24,0">
            <Label Text="Aucun changement de prix" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" HorizontalTextAlignment="Center" />
            <Label Text="Les prix changés depuis un conseil du guide ou une commande apparaîtront ici."
                   Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Batches}" SelectionMode="None" Margin="16,12,16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PriceBatch">
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" Style="{StaticResource UiTitle}" FontSize="16" />
                            <Label Text="{Binding DetailText}" Style="{StaticResource UiBody}" FontSize="13" />
                            <Label Text="{Binding StatusText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource ThemePrimary}" />
                            <Button Text="Remettre les anciens prix" IsVisible="{Binding CanUndo}"
                                    Command="{Binding Path=BindingContext.UndoCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent" TextColor="#B91C1C" FontFamily="InterSemiBold" FontSize="14"
                                    HorizontalOptions="Start" Padding="0" />
                        </VerticalStackLayout>
                    </components:UiCard>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
