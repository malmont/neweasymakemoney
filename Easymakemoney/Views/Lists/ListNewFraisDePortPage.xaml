<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:ListNewFraisDePortViewModel"
             x:Class="Easymakemoney.Views.Lists.ListNewFraisDePortPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Frais de port">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout>
            <components:AppHeader Title="Frais de port" />
            <Border IsVisible="{Binding IsClosed}" Margin="16,12,16,0" Padding="12,10" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#FEE2E2">
                <Label Text="Période clôturée : plus rien ne peut y être ajouté." FontFamily="InterSemiBold" FontSize="14" TextColor="#B91C1C" />
            </Border>
        </VerticalStackLayout>

        <components:NavbarContentView Grid.Row="1"
                                      ButtonCommand="{Binding ShowBottomSheetPopupListViewCommand}"
                                      ImageButtonSourceList="{Binding CollectionImage}"
                                      HideCreate="True"
                                      LabelText="Période"
                                      PlaceholderText="Choisir une période"
                                      Icon="M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4"
                                      ValueText="{Binding CollectionName}"/>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding ShowEmptyState}" VerticalOptions="Center" Spacing="10" Padding="24,0">
            <Label Text="{Binding EmptyTitle}" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding EmptyMessage}" Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="None" Margin="16,8,16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x1:FraisDePortCommandeRow">
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <components:UiThumb Grid.Column="0" Source="{Binding Image}" Icon="M3 6h11v11H3zM14 10h4l3 3v4h-7M7 20a2 2 0 100-4 2 2 0 000 4zM17 20a2 2 0 100-4 2 2 0 000 4z" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding CommandeName}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding DetailText}" Style="{StaticResource UiBody}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding PriceText}"
                                           IsVisible="{Binding HasFrais}"
                                           FontFamily="InterBold"
                                           FontSize="15"
                                           TextColor="{DynamicResource ThemePrimary}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        IsVisible="{Binding CanDeleteFrais}"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="Supprimer le frais de port">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.DeleteFraisDePortCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Path Data="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"
                                          Style="{StaticResource UiIcon}"
                                          Stroke="#B91C1C"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <Border IsVisible="{Binding CanAddFrais}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12"
                                    BackgroundColor="{DynamicResource ThemePrimaryTint}"
                                    SemanticProperties.Description="Ajouter un frais de port">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.AddFraisCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="Ajouter un frais de port"
                                       FontFamily="InterBold"
                                       FontSize="15"
                                       TextColor="{DynamicResource ThemePrimary}"
                                       HorizontalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </components:UiCard>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
