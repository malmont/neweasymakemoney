<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:ReportsViewModel"
             x:Class="Easymakemoney.Views.Lists.ReportsPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Mes rapports">

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Mes rapports" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Les bilans PDF du site, gardés 90 jours. Un bilan de période se demande depuis l'écran de son budget ; celui de l'année, ici ou depuis l'écran de l'année." Style="{StaticResource UiBody}" FontSize="13" />
                <Button Text="Bilan PDF de l'exercice en cours" Command="{Binding RequestCurrentYearCommand}" HeightRequest="44" CornerRadius="12"
                        FontFamily="InterSemiBold" FontSize="13" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="White" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" HeightRequest="24" />
                <Label Text="Aucun rapport pour l'instant." IsVisible="{Binding IsEmpty}" Style="{StaticResource UiBody}" FontSize="13" />

                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Reports}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:GestionReport">
                            <Border StrokeShape="RoundRectangle 12" Padding="12,10" StrokeThickness="1" Stroke="{StaticResource UiBorder}" BackgroundColor="{StaticResource UiSurface}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding title}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                        <Label Text="{Binding DetailText}" Style="{StaticResource UiBody}" FontSize="12" />
                                        <Label Text="{Binding StateText}" Style="{StaticResource UiBody}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="Effacer" FontFamily="InterSemiBold" FontSize="12" TextColor="#B91C1C" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.DeleteCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.OpenCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
