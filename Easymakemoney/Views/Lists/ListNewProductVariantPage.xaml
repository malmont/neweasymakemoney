<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:ListNewProductsVariantViewModel"
             x:Class="Easymakemoney.Views.Lists.ListNewProductVariantPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Variantes">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Variantes" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding ListProductVariants}" SelectionMode="None" Margin="16,8,16,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="24,80">
                    <Label Text="Aucune variante" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Touchez + pour en créer une." Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x1:ProductVariant">
                    <components:UiCard Style="{StaticResource UiCard}" Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding color.name}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                            <Border Stroke="{StaticResource UiBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="0">
                                <BoxView Color="{Binding color.codeHexa}" HeightRequest="44" CornerRadius="10" />
                            </Border>
                            <Label Text="{Binding size.name, StringFormat='Taille : {0}'}" Style="{StaticResource UiBody}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding stockQuantity, StringFormat='Stock : {0}'}" Style="{StaticResource UiBody}" />
                            <Button Text="Supprimer" BackgroundColor="#B91C1C" TextColor="White" FontFamily="InterSemiBold" FontSize="14"
                                    CornerRadius="12" HeightRequest="44"
                                    Command="{Binding Path=BindingContext.DeleteProductVariantCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </components:UiCard>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1" WidthRequest="60" HeightRequest="60" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                BackgroundColor="{DynamicResource ThemePrimary}" HorizontalOptions="End" VerticalOptions="End" Margin="16,0,16,28"
                SemanticProperties.Description="Ajouter une variante">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShowBottomSheetCommand}" />
            </Border.GestureRecognizers>
            <Path Data="M12 5v14M5 12h14" Stroke="{DynamicResource ThemeOnPrimary}" StrokeThickness="2.4" StrokeLineCap="Round"
                  WidthRequest="24" HeightRequest="24" Aspect="None" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
