<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:StockLowViewModel"
             x:Class="Easymakemoney.Views.Lists.StockLowPage"
             Style="{StaticResource UiPage}"
             Title="Stock bas">

    <Grid RowDefinitions="Auto,Auto,*">
        <components:AppHeader Title="{Binding PageTitle}" />

        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,0" Spacing="4">
            <Label Text="{Binding Intro}" Style="{StaticResource UiBody}" FontSize="15" />
            <Label Text="{Binding SourcesText}" Style="{StaticResource UiBody}" FontSize="12" />
        </VerticalStackLayout>

        <Label Grid.Row="2" IsVisible="{Binding IsEmpty}" Text="Aucun article pour l'instant."
               Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" VerticalOptions="Center" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None" Margin="16,12,16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LowStockItem">
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding name}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SoldText}" Style="{StaticResource UiBody}" FontSize="13" />
                                <Label Text="{Binding PriceText}" IsVisible="{Binding HasPrice}" Style="{StaticResource UiBody}" FontSize="13" />
                                <Label Text="{Binding DaysLeftText}" IsVisible="{Binding HasDaysLeft}" FontFamily="InterSemiBold" FontSize="13" TextColor="#B45309" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding StockText}" FontFamily="InterBold" FontSize="15"
                                   TextColor="{StaticResource UiTextPrimary}" VerticalOptions="Center" />
                        </Grid>
                    </components:UiCard>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
