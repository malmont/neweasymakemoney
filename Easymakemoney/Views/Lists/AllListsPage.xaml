<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:AllListsViewModel"
             x:Class="Easymakemoney.Views.Lists.AllListsPage"
             Style="{StaticResource UiPage}"
             Title="Gestion">

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Gestion" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <components:UiTile Command="{Binding NewCommandCommand}" Icon="M12 5v14M5 12h14" Title="Nouvelle commande" Text="Classée automatiquement dans sa période" />
                <components:UiTile Command="{Binding NavigateToSupplierInvoiceCommand}" Icon="M6 3h9l4 4v14H6zM9 9h3M9 13h7M9 17h7M14 3v4h5" Title="Lire une facture fournisseur" Text="Photo ou PDF, vérifiée ligne par ligne" />
                <components:UiTile Command="{Binding NavigateToCollectionCommand}" Icon="M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4" Title="Périodes" Text="Commandes et produits par collection" />
                <components:UiTile Command="{Binding NavigateToNoteFournisseurCommand}" Icon="M3 21V8l9-5 9 5v13M9 21v-7h6v7" Title="Fournisseurs" Text="Coordonnées et type de fournisseur" />
                <components:UiTile Command="{Binding NavigateToNoteDeFraisCommand}" Icon="M6 3h9l4 4v14H6zM9 12h7M9 16h7" Title="Notes de frais" Text="Dépenses rattachées aux collections" />
                <components:UiTile Command="{Binding NavigateToAdvertisingCommand}" Icon="M3 10v4h3l6 4V6L6 10H3zM16 9a4 4 0 010 6M19 6a8 8 0 010 12" Title="Publicité" Text="Campagnes et rentabilité estimée" />
                <components:UiTile Command="{Binding NavigateToFraisDePortCommand}" Icon="M3 6h11v11H3zM14 10h4l3 3v4h-7M7 20a2 2 0 100-4 2 2 0 000 4zM17 20a2 2 0 100-4 2 2 0 000 4z" Title="Frais de port" Text="Transport des commandes" />
                <components:UiTile Command="{Binding NavigateToToClassifyCommand}" Icon="M3 6h18M3 12h18M3 18h12" Title="À classer" Text="Articles qui ne sont dans aucune commande" />
                <components:UiTile Command="{Binding NavigateToRepriseCommand}" Icon="M3 12a9 9 0 109-9 9 9 0 00-6.4 2.6L3 8M3 3v5h5M12 7v5l3 2" Title="Reprise d'historique" Text="Donner un coût à vos ventes passées" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
