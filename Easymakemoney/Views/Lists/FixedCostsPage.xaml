<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:FixedCostsViewModel"
             x:Class="Easymakemoney.Views.Lists.FixedCostsPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Frais fixes">

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Frais fixes" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None" Margin="16,0">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,12,0,12" Spacing="10">
                    <components:UiCard Style="{StaticResource UiCard}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <components:UiTerm Term="frais-fixes" Text="Total des frais fixes par mois" FontSize="14" />
                            <Label Text="{Binding MonthlyTotalText}" FontFamily="InterBold" FontSize="24" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="2" Margin="0,4,0,4" BindableLayout.ItemsSource="{Binding Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FixedCostCategory">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding label}" Style="{StaticResource UiBody}" FontSize="13" />
                                            <Label Grid.Column="1" Text="{Binding MonthlyText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource UiTextPrimary}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="Saisis une fois, ils comptent dans la trésorerie à chaque échéance et dans le résultat de chaque période, au prorata des jours. Ne les saisissez pas aussi en note de frais."
                                   Style="{StaticResource UiBody}" FontSize="12" />
                        </VerticalStackLayout>
                    </components:UiCard>
                    <Button Text="Ajouter un frais fixe" Command="{Binding AddCommand}" HeightRequest="48" CornerRadius="12"
                            FontFamily="InterBold" FontSize="15" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="{DynamicResource ThemeOnPrimary}" />
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="8" Padding="8,24,8,0">
                        <Label Text="Aucun frais fixe" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" HorizontalTextAlignment="Center" />
                        <Label Text="Ajoutez votre loyer, vos salaires, vos assurances, votre électricité… avec leur fréquence (par mois, par trimestre, par an)."
                               Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FixedCostItem">
                    <SwipeView Margin="0,0,0,10">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Supprimer" BackgroundColor="#B91C1C"
                                           Command="{Binding Path=BindingContext.DeleteCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid BackgroundColor="{StaticResource UiBackground}">
                            <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                                <components:UiCard.Triggers>
                                    <DataTrigger TargetType="components:UiCard" Binding="{Binding active}" Value="False">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </components:UiCard.Triggers>
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding label}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding AmountText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                    <Label Text="{Binding StatusText}" Style="{StaticResource UiBody}" FontSize="12" />
                                </VerticalStackLayout>
                            </components:UiCard>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
