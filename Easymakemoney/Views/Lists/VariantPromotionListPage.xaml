<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:VariantPromotionListViewModel"
             x:Class="Easymakemoney.Views.Lists.VariantPromotionListPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Promotions par variante">

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Promotions par variante" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <components:UiTerm Term="promotion-variante" Text="Une remise datée sur une taille ou une couleur précise. Pour en créer une : Gestion › un article › Promo › « Choisir une taille ou une couleur »." FontSize="13" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" />
                <Label Text="Aucune promotion par variante en cours ou à venir." IsVisible="{Binding IsEmpty}" Style="{StaticResource UiBody}" FontSize="14" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:VariantPromotionItem">
                            <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                                <VerticalStackLayout Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Title}" Style="{StaticResource UiTitle}" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding StatusText}" FontFamily="InterSemiBold" FontSize="12" TextColor="{DynamicResource ThemePrimary}" />
                                    </Grid>
                                    <Label Text="{Binding PriceText}" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                    <Label Text="{Binding DatesText}" Style="{StaticResource UiBody}" FontSize="12" />
                                    <Label Text="Terminer" IsVisible="{Binding CanEnd}" FontFamily="InterSemiBold" FontSize="13" TextColor="#B91C1C" Margin="0,4,0,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.EndCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </components:UiCard>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
