<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:PromotionListViewModel"
             x:Class="Easymakemoney.Views.Lists.PromotionListPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Promotions">

    <Grid RowDefinitions="Auto,Auto,*">
        <components:AppHeader Title="Promotions" />

        <Label Grid.Row="1" Padding="16,12,16,0" Style="{StaticResource UiBody}" FontSize="13"
               Text="Promotions en cours et à venir. Le prix normal revient tout seul à la fin. Pour en créer une : un conseil du guide, ou « Promo » sur un article d'une commande." />

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsEmpty}" VerticalOptions="Center" Spacing="8" Padding="24,0">
            <Label Text="Aucune promotion" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" HorizontalTextAlignment="Center" />
            <Label Text="Aucune promotion en cours ni à venir." Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Promotions}" SelectionMode="None" Margin="16,12,16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PromotionItem">
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Path=BindingContext.ShowAdminInfoCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding name}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding StatusText}" FontFamily="InterSemiBold" FontSize="12" TextColor="{DynamicResource ThemePrimary}" />
                            </Grid>
                            <Label Text="{Binding PriceText}" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource UiTextPrimary}" />
                            <Label Text="{Binding DatesText}" Style="{StaticResource UiBody}" FontSize="13" />
                            <Label Text="Saisie dans l'administration du site" IsVisible="{Binding FromAdmin}" Style="{StaticResource UiBody}" FontSize="12" />
                            <Button Text="Terminer maintenant" IsVisible="{Binding CanEnd}"
                                    Command="{Binding Path=BindingContext.EndCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent" TextColor="#B91C1C" FontFamily="InterSemiBold" FontSize="14"
                                    HorizontalOptions="Start" Padding="0" />
                        </VerticalStackLayout>
                    </components:UiCard>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
