<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:stats="clr-namespace:Easymakemoney.ViewModels.Statistiques"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:LossFindingListViewModel"
             x:Class="Easymakemoney.Views.Lists.LossFindingListPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Prévention des pertes">

    <ContentPage.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
        </Style>
        <Style x:Key="FormField" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Prévention des pertes" />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Label Text="Les faits que la caisse a enregistrés et qui méritent votre vérification. Un constat n'accuse personne et ne prouve aucune perte : la décision vous revient." Style="{StaticResource UiBody}" FontSize="13" />

                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding IsModuleInactive}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Prévention des pertes non activée" Style="{StaticResource UiTitle}" FontSize="15" />
                            <Label Text="{Binding ModuleInactiveText}" Style="{StaticResource UiBody}" FontSize="13" />
                        </VerticalStackLayout>
                    </components:UiCard>

                    <!-- Synthèse -->
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding HasSummary}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <components:UiTerm Term="constat" Text="À traiter" FontSize="12" />
                                    <Label Text="{Binding Summary.counts.active}" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Nouveaux" Style="{StaticResource UiBody}" FontSize="12" />
                                    <Label Text="{Binding Summary.counts.new}" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <components:UiTerm Term="montant-en-jeu" Text="En jeu" FontSize="12" />
                                    <Label Text="{Binding Summary.AmountText}" FontFamily="InterBold" FontSize="17" TextColor="{StaticResource UiTextPrimary}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding Summary.BlockedText}" IsVisible="{Binding Summary.IsBlocked}" FontFamily="InterSemiBold" FontSize="13" TextColor="#B45309" />
                            <Label Text="{Binding Summary.CashDeskText}" Style="{StaticResource UiBody}" FontSize="12" />
                            <Label Text="{Binding Summary.LastAnalysisText}" Style="{StaticResource UiBody}" FontSize="12" />
                        </VerticalStackLayout>
                    </components:UiCard>

                    <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-8" BindableLayout.ItemsSource="{Binding Filters}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="stats:StatsChoice">
                            <Border Style="{StaticResource Chip}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimary}" />
                                        <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectFilterCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding Code}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource UiTextPrimary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeOnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                    <Label Text="Aucun constat pour ce filtre." IsVisible="{Binding IsEmpty}" Style="{StaticResource UiBody}" FontSize="14" />

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Findings}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:LossFinding">
                                <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                                    <components:UiCard.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.OpenCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                    </components:UiCard.GestureRecognizers>
                                    <VerticalStackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding HeaderText}" FontFamily="InterSemiBold" FontSize="12" TextColor="{DynamicResource ThemePrimary}" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding BadgeText}" IsVisible="{Binding HasBadge}" FontFamily="InterSemiBold" FontSize="12" TextColor="#B45309" />
                                        </Grid>
                                        <Label Text="{Binding summary}" Style="{StaticResource UiTitle}" FontSize="14" />
                                        <Label Text="{Binding DetailText}" Style="{StaticResource UiBody}" FontSize="12" />
                                        <Label Text="{Binding statusLabel}" FontFamily="InterMedium" FontSize="12" TextColor="{StaticResource UiTextSecondary}" />
                                    </VerticalStackLayout>
                                </components:UiCard>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Voir plus" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" HeightRequest="44" CornerRadius="12"
                            FontFamily="InterSemiBold" FontSize="14" BackgroundColor="{StaticResource UiSurface}" TextColor="{DynamicResource ThemePrimary}"
                            BorderColor="{DynamicResource ThemePrimary}" BorderWidth="1" />

                    <Label Text="{Binding Summary.CaveatsText}" IsVisible="{Binding HasSummary}" Style="{StaticResource UiBody}" FontSize="12" />
                    <Label Text="Règles, seuils, réglages et notice aux salariés : sur le web, dans la gestion." Style="{StaticResource UiBody}" FontSize="12" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
