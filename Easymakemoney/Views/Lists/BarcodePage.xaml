<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:BarcodeViewModel"
             x:Class="Easymakemoney.Views.Lists.BarcodePage"
             Style="{StaticResource UiPage}"
             Title="Codes-barres">

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Codes-barres" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Scannez ou tapez un code pour retrouver l'article. Un code désigne une seule fiche ; un lecteur branché au téléphone marche aussi dans la case." Style="{StaticResource UiBody}" FontSize="13" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Text="{Binding Code}" Placeholder="Code-barres" ReturnType="Search" ReturnCommand="{Binding SearchCommand}" FontSize="15" />
                    <Button Grid.Column="1" Text="Chercher" Command="{Binding SearchCommand}" HeightRequest="44" CornerRadius="12"
                            FontFamily="InterSemiBold" FontSize="13" BackgroundColor="{StaticResource UiSurface}" TextColor="{DynamicResource ThemePrimary}"
                            BorderColor="{DynamicResource ThemePrimary}" BorderWidth="1" />
                </Grid>
                <Button Text="Scanner avec l'appareil photo" Command="{Binding ScanCommand}" HeightRequest="48" CornerRadius="12"
                        FontFamily="InterSemiBold" FontSize="14" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="White" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" HeightRequest="24" />

                <!-- Fiche trouvée -->
                <Border IsVisible="{Binding HasSheet}" StrokeShape="RoundRectangle 12" Padding="14,12" StrokeThickness="1" Stroke="{StaticResource UiBorder}" BackgroundColor="{StaticResource UiSurface}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Sheet.KindText}" Style="{StaticResource UiBody}" FontSize="11" />
                        <Label Text="{Binding Sheet.Title}" FontFamily="InterSemiBold" FontSize="16" TextColor="{StaticResource UiTextPrimary}" />
                        <Label Text="{Binding Sheet.CodeText}" FontFamily="InterSemiBold" FontSize="15" TextColor="{DynamicResource ThemePrimary}" />
                        <Label Text="{Binding Sheet.StockText}" Style="{StaticResource UiBody}" FontSize="13" />
                        <Label Text="{Binding Sheet.PriceText}" Style="{StaticResource UiBody}" FontSize="13" />
                        <Label Text="{Binding Sheet.ChannelsText}" Style="{StaticResource UiBody}" FontSize="13" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,8,0,0">
                            <Button Text="Étiquettes" Command="{Binding PrintLabelCommand}" HeightRequest="40" CornerRadius="10" FontSize="12" FontFamily="InterSemiBold"
                                    BackgroundColor="{DynamicResource ThemePrimary}" TextColor="White" />
                            <Button Grid.Column="1" Text="Remplacer" Command="{Binding ReplaceCommand}" HeightRequest="40" CornerRadius="10" FontSize="12" FontFamily="InterSemiBold"
                                    BackgroundColor="{StaticResource UiSurface}" TextColor="{DynamicResource ThemePrimary}" BorderColor="{DynamicResource ThemePrimary}" BorderWidth="1" />
                            <Button Grid.Column="2" Text="Retirer" Command="{Binding RemoveCommand}" HeightRequest="40" CornerRadius="10" FontSize="12" FontFamily="InterSemiBold"
                                    BackgroundColor="{StaticResource UiSurface}" TextColor="#B91C1C" BorderColor="#B91C1C" BorderWidth="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Code non porté, ou refusé -->
                <Label Text="{Binding Result.StatusText}" IsVisible="{Binding Result.HasStatus}" Style="{StaticResource UiBody}" FontSize="13" />
                <Button Text="Poser ce code sur un article" IsVisible="{Binding CanAssign}" Command="{Binding AssignCommand}" HeightRequest="44" CornerRadius="12"
                        FontFamily="InterSemiBold" FontSize="13" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="White" />

                <BoxView HeightRequest="1" Color="{StaticResource UiBorder}" Margin="0,8" />

                <Label Text="Fiches sans code" FontFamily="InterSemiBold" FontSize="15" TextColor="{StaticResource UiTextPrimary}" />
                <Label Text="{Binding Missing.Text}" Style="{StaticResource UiBody}" FontSize="13" />
                <Button Text="Générer les codes manquants" Command="{Binding GenerateMissingCommand}" IsVisible="{Binding Missing.HasMissing}" HeightRequest="44" CornerRadius="12"
                        FontFamily="InterSemiBold" FontSize="13" BackgroundColor="{StaticResource UiSurface}" TextColor="{DynamicResource ThemePrimary}"
                        BorderColor="{DynamicResource ThemePrimary}" BorderWidth="1" />
                <Button Text="Générer le code d'un article" Command="{Binding GenerateForSheetCommand}" HeightRequest="44" CornerRadius="12"
                        FontFamily="InterSemiBold" FontSize="13" BackgroundColor="{StaticResource UiSurface}" TextColor="{DynamicResource ThemePrimary}"
                        BorderColor="{DynamicResource ThemePrimary}" BorderWidth="1" />
                <Label Text="Un code généré commence par 29 (usage interne au magasin). Le code du fabricant, s'il y en a un, reste le meilleur : scannez-le puis posez-le sur la fiche." Style="{StaticResource UiBody}" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
