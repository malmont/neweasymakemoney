<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:ListNewCollectionViewModel"
             x:Class="Easymakemoney.Views.Lists.ListNewCollectionPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Collections">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
            <converters:IsoDateConverter x:Key="IsoDateConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Collections" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding ListCollections}" SelectionMode="None" Margin="16,8,16,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="24,80">
                    <Label Text="Aucune collection" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Touchez + pour créer votre première collection." Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x1:ListCollection">
                    <SwipeView Margin="0,0,0,10">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Supprimer" BackgroundColor="#B91C1C"
                                           Command="{Binding Path=BindingContext.DeleteCollectionCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding nomCollection}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                                <Label Style="{StaticResource UiBody}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding startDateCollection, Converter={StaticResource IsoDateConverter}}" />
                                            <Span Text=" au " />
                                            <Span Text="{Binding endDateCollection, Converter={StaticResource IsoDateConverter}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding budgetCollection, StringFormat='Budget : {0}', Converter={StaticResource CurrencyConverter}}"
                                       FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource ThemePrimary}" />
                            </VerticalStackLayout>
                        </components:UiCard>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1" WidthRequest="60" HeightRequest="60" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                BackgroundColor="{DynamicResource ThemePrimary}" HorizontalOptions="End" VerticalOptions="End" Margin="16,0,16,28"
                SemanticProperties.Description="Ajouter une collection">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShowBottomSheetCommand}" />
            </Border.GestureRecognizers>
            <Path Data="M12 5v14M5 12h14" Stroke="{DynamicResource ThemeOnPrimary}" StrokeThickness="2.4" StrokeLineCap="Round"
                  WidthRequest="24" HeightRequest="24" Aspect="None" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
