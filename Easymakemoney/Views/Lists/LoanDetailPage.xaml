<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:handlers="clr-namespace:Easymakemoney.Handlers"
             x:DataType="list:LoanDetailViewModel"
             x:Class="Easymakemoney.Views.Lists.LoanDetailPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Prêt">

    <ContentPage.Resources>
        <Style x:Key="FormField" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="FormEntry" TargetType="handlers:BorderlessEntry">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource UiTextMuted}" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>
        <Style x:Key="FormDate" TargetType="handlers:BorderlessDatePicker">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="InterMedium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource UiTextSecondary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Prêt" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Schedule}" SelectionMode="None" Margin="16,0">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,12,0,12" Spacing="10" IsVisible="{Binding HasLoan}">
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding IsReadOnly}">
                        <Label Text="{Binding ReadOnlyText}" Style="{StaticResource UiBody}" FontSize="13" TextColor="#B45309" />
                    </components:UiCard>

                    <components:UiCard Style="{StaticResource UiCard}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Loan.label}" Style="{StaticResource UiTitle}" FontSize="18" />
                            <Label Text="{Binding Loan.lender}" IsVisible="{Binding Loan.HasLender}" Style="{StaticResource UiBody}" FontSize="13" />
                            <Label Text="{Binding Loan.TermsText}" Style="{StaticResource UiBody}" FontSize="13" />
                            <Label Text="{Binding Loan.DatesText}" Style="{StaticResource UiBody}" FontSize="12" />
                            <Label Text="{Binding Loan.DeferralText}" IsVisible="{Binding Loan.HasDeferral}" Style="{StaticResource UiBody}" FontSize="12" />
                            <Label Text="{Binding Loan.InsuranceModeText}" Style="{StaticResource UiBody}" FontSize="12" />
                            <Label Text="{Binding Loan.OtherCurrencyText}" IsVisible="{Binding Loan.IsOtherCurrency}" Style="{StaticResource UiBody}" FontSize="12" TextColor="#B45309" />
                            <Label Text="{Binding Loan.notes}" IsVisible="{Binding Loan.HasNotes}" Style="{StaticResource UiBody}" FontSize="12" FontAttributes="Italic" />
                        </VerticalStackLayout>
                    </components:UiCard>

                    <components:UiCard Style="{StaticResource UiCard}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <components:UiTerm Term="capital-restant-du" Text="Restant dû aujourd'hui" FontSize="14" />
                            <Label Text="{Binding Loan.RemainingText}" FontFamily="InterBold" FontSize="24" TextColor="{StaticResource UiTextPrimary}" />
                            <Label Text="{Binding Loan.NextInstalmentLine}" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource UiTextPrimary}" />
                        </VerticalStackLayout>
                    </components:UiCard>

                    <components:UiCard Style="{StaticResource UiCard}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <components:UiTerm Term="cout-du-credit" Text="Coût total du crédit" FontSize="14" />
                            <Label Text="{Binding Loan.CreditCostText}" FontFamily="InterBold" FontSize="22" TextColor="{StaticResource UiTextPrimary}" />
                            <components:UiAmountRow Title="Intérêts" Value="{Binding Loan.InterestText}" />
                            <components:UiAmountRow Title="Assurance" Value="{Binding Loan.InsuranceText}" IsVisible="{Binding Loan.HasInsurance}" />
                            <components:UiAmountRow Title="Frais" Value="{Binding Loan.FeesText}" IsVisible="{Binding Loan.HasFees}" />
                            <Label Text="{Binding Loan.PrepaymentFeesText}" IsVisible="{Binding Loan.HasPrepaymentFees}" Style="{StaticResource UiBody}" FontSize="12" HorizontalOptions="End" />
                            <components:UiAmountRow Title="Capital emprunté (à part)" Value="{Binding Loan.CapitalText}" IsTotal="True" />
                            <Label Text="{Binding CapitalNotChargeText}" Style="{StaticResource UiBody}" FontSize="12" />
                            <Label Text="{Binding Loan.CapitalizedText}" IsVisible="{Binding Loan.HasCapitalized}" Style="{StaticResource UiBody}" FontSize="12" />
                            <components:UiAmountRow Title="Total remboursé (capital et coût du crédit)" Value="{Binding Loan.PaidText}" />
                        </VerticalStackLayout>
                    </components:UiCard>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding CanWrite}">
                        <Button Text="Modifier" Command="{Binding EditCommand}" HeightRequest="48" CornerRadius="12"
                                FontFamily="InterBold" FontSize="15" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="{DynamicResource ThemeOnPrimary}" />
                        <Button Grid.Column="1" Text="Supprimer" Command="{Binding DeleteCommand}" HeightRequest="48" CornerRadius="12"
                                FontFamily="InterBold" FontSize="15" BackgroundColor="{StaticResource UiSurface}" TextColor="#B91C1C" BorderColor="#B91C1C" BorderWidth="1" />
                    </Grid>

                    <components:UiCard Style="{StaticResource UiCard}" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Remboursements anticipés" Style="{StaticResource UiTitle}" FontSize="16" />
                            <Label Text="La date de fin ne change pas : les échéances suivantes baissent. Les frais tombent à la date du remboursement."
                                   Style="{StaticResource UiBody}" FontSize="12" />
                            <Label Text="Aucun remboursement anticipé." IsVisible="{Binding HasNoPrepayments}" Style="{StaticResource UiBody}" FontSize="13" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Prepayments}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:LoanPrepayment">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding TitleText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                                <Label Text="{Binding FeesText}" Style="{StaticResource UiBody}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="Retirer" FontSize="13" HeightRequest="36" Padding="12,0" CornerRadius="10"
                                                    BackgroundColor="Transparent" TextColor="#B91C1C"
                                                    IsVisible="{Binding Path=BindingContext.CanWrite, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                    Command="{Binding Path=BindingContext.DeletePrepaymentCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Button Text="Ajouter un remboursement anticipé" Command="{Binding TogglePrepaymentFormCommand}" IsVisible="{Binding CanWrite}"
                                    HeightRequest="44" CornerRadius="12" FontFamily="InterSemiBold" FontSize="14"
                                    BackgroundColor="Transparent" TextColor="{DynamicResource ThemePrimary}" BorderColor="{DynamicResource ThemePrimary}" BorderWidth="1" />
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsPrepaymentFormVisible}">
                                <Label Text="Date" Style="{StaticResource FormLabel}" />
                                <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                                    <handlers:BorderlessDatePicker Style="{StaticResource FormDate}" Date="{Binding PrepaymentDate}" Format="dd/MM/yyyy" />
                                </Border>
                                <Label Text="Montant remboursé" Style="{StaticResource FormLabel}" />
                                <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                                    <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="0,00" Keyboard="Numeric" Text="{Binding PrepaymentAmountText}" />
                                </Border>
                                <Label Text="Frais (facultatif)" Style="{StaticResource FormLabel}" />
                                <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                                    <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="0,00" Keyboard="Numeric" Text="{Binding PrepaymentFeesText}" />
                                </Border>
                                <Label Text="{Binding PrepaymentError}" IsVisible="{Binding HasPrepaymentError}" Style="{StaticResource UiBody}" FontSize="12" TextColor="#B91C1C" />
                                <Button Text="Enregistrer le remboursement" Command="{Binding AddPrepaymentCommand}" HeightRequest="48" CornerRadius="12"
                                        FontFamily="InterBold" FontSize="15" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="{DynamicResource ThemeOnPrimary}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>

                    <Label Text="Échéancier" Style="{StaticResource UiTitle}" FontSize="16" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LoanInstalment">
                    <Grid Padding="0,0,0,8">
                        <components:UiCard Style="{StaticResource UiCard}" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding TitleText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                    <Label Grid.Column="1" Text="{Binding TotalText}" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                </Grid>
                                <Label Text="{Binding DetailText}" Style="{StaticResource UiBody}" FontSize="12" />
                                <Label Text="{Binding NoteText}" IsVisible="{Binding HasNote}" Style="{StaticResource UiBody}" FontSize="12" TextColor="#B45309" />
                            </VerticalStackLayout>
                        </components:UiCard>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
