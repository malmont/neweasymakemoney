<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Lists"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:DataType="list:ListNewNoteDeFraisViewModel"
             x:Class="Easymakemoney.Views.Lists.ListNewNoteDeFraisPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Notes de frais">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout>
            <components:AppHeader Title="Notes de frais" />
            <Border IsVisible="{Binding IsClosed}" Margin="16,12,16,0" Padding="12,10" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#FEE2E2">
                <Label Text="Période clôturée : plus rien ne peut y être ajouté." FontFamily="InterSemiBold" FontSize="14" TextColor="#B91C1C" />
            </Border>
        </VerticalStackLayout>

        <components:NavbarContentView Grid.Row="1"
                                      ButtonText="Listes"
                                      ButtonCommand="{Binding ShowBottomSheetPopupListViewCommand}"
                                      ImageButtonSourceList="{Binding CollectionImage}"
                                      ImageButtonSource="boutonaddblanc64.png"
                                      ImageButtonCommand="{Binding ShowBottomSheetCreateListCommand}"
                                      HideCreate="True"
                                      LabelText="Période"
                                      PlaceholderText="Choisir une période"
                                      Icon="M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4"
                                      ValueText="{Binding CollectionName}"/>

        <CollectionView Grid.Row="2" ItemsSource="{Binding ListNoteDeFrais}" SelectionMode="None" Margin="16,8,16,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="24,80">
                    <Label Text="Aucune note de frais" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Choisissez une période, puis touchez + pour en créer une." Style="{StaticResource UiBody}" FontSize="15" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x1:NoteDeFrais">
                    <SwipeView Margin="0,0,0,10">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Supprimer" BackgroundColor="#B91C1C" IsVisible="{Binding Path=BindingContext.CanEdit, Source={x:Reference Page}, x:DataType=ContentPage}"
                                           Command="{Binding Path=BindingContext.DeleteNoteDefraisCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <!-- Fond opaque : le rouge de la suppression ne doit pas apparaître dans les coins arrondis au repos -->
                        <Grid BackgroundColor="{StaticResource UiBackground}">
                            <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedNoteDeFrais, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <components:UiThumb Grid.Column="0" Source="{Binding imageNdf}" Icon="M6 3h9l4 4v14H6zM9 12h7M9 16h7" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding name}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding montant, StringFormat='Montant : {0}', Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource ThemePrimary}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </components:UiCard>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" IsVisible="{Binding CanEdit}" WidthRequest="60" HeightRequest="60" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                BackgroundColor="{DynamicResource ThemePrimary}" HorizontalOptions="End" VerticalOptions="End" Margin="16,0,16,28"
                SemanticProperties.Description="Ajouter une note de frais">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShowBottomSheetCommand}" />
            </Border.GestureRecognizers>
            <Path Data="M12 5v14M5 12h14" Stroke="{DynamicResource ThemeOnPrimary}" StrokeThickness="2.4" StrokeLineCap="Round"
                  WidthRequest="24" HeightRequest="24" Aspect="None" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
