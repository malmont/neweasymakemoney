<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:Statistique="clr-namespace:Easymakemoney.ViewModels.Statistiques"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             x:DataType="Statistique:StockEvolutionViewModel"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="Easymakemoney.Views.Statistiques.StockPage"
             Style="{StaticResource UiPage}"
             Title="Stock">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Stock"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Button Text="Période"
                        Command="{Binding ShowBottomSheetPopupListViewCommand}"
                        BackgroundColor="{DynamicResource ThemePrimaryTint}"
                        TextColor="{DynamicResource ThemePrimary}"
                        FontFamily="InterSemiBold"
                        FontSize="14"
                        CornerRadius="12"
                        MinimumHeightRequest="44"
                        Padding="20,0"
                        HorizontalOptions="Start"/>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <components:UiGlyph Data="M3 17l6-6 4 4 8-8M15 7h6v6" />
                    <Label Grid.Column="1"
                           Text="Valeur du stock"
                           Style="{StaticResource UiTitle}"
                           VerticalTextAlignment="Center"/>
                </Grid>
                <components:UiCard Style="{StaticResource UiCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding StockDataValueCurrentMonth.MonthText}"
                               Style="{StaticResource UiBody}"/>
                        <Label Text="{Binding StockDataValueCurrentMonth.StockValueCents, Converter={StaticResource CurrencyConverter}}"
                               FontFamily="InterBold"
                               FontSize="22"
                               TextColor="{DynamicResource ThemePrimary}"/>
                    </VerticalStackLayout>
                </components:UiCard>
                <Label Text="{Binding StockCurrentPeriode}" Style="{StaticResource UiTitle}"/>
                <components:UiCard Style="{StaticResource UiCard}" Padding="16,4">
                    <CollectionView ItemsSource="{Binding AllDataValue}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x1:IStatistiqueData">
                                <components:StatistiqueDataBadgeView Date="{Binding Data1}"
                                                                     Revenue="{Binding Data2}"
                                                                     FrameBackgroundColor="{Binding BackgroundColor}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </components:UiCard>
                <components:UiCard Style="{StaticResource UiCard}" IsVisible="{Binding IsWeekChartVisible}">
                    <microcharts:ChartView Chart="{Binding WeekChart, Mode=TwoWay}"
                                           HeightRequest="200"
                                           HorizontalOptions="Fill"/>
                </components:UiCard>
                <components:UiCard Style="{StaticResource UiCard}" IsVisible="{Binding IsMonthChartVisible}">
                    <microcharts:ChartView Chart="{Binding MonthChart, Mode=TwoWay}"
                                           HeightRequest="200"
                                           HorizontalOptions="Fill"/>
                </components:UiCard>
                <components:UiCard Style="{StaticResource UiCard}" IsVisible="{Binding IsYearChartVisible}">
                    <microcharts:ChartView Chart="{Binding YearChart, Mode=TwoWay}"
                                           HeightRequest="200"
                                           HorizontalOptions="Fill"/>
                </components:UiCard>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
