<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Statistique="clr-namespace:Easymakemoney.ViewModels.Statistiques"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:handlers="clr-namespace:Easymakemoney.Handlers"
             x:DataType="Statistique:RentalPromotionViewModel"
             x:Class="Easymakemoney.Views.Statistiques.RentalPromotionPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Promotion de location">

    <ContentPage.Resources>
        <!-- Styles de formulaire : ils ne sont pas globaux -->
        <Style x:Key="FormDate" TargetType="handlers:BorderlessDatePicker">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="InterMedium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource UiTextSecondary}" />
        </Style>
        <Style x:Key="FormField" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="FormEntry" TargetType="handlers:BorderlessEntry">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource UiTextMuted}" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Promotion de location" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="{Binding ScopeText}" Style="{StaticResource UiBody}" FontSize="14" />

                <components:UiTerm Term="promotion-location" Text="Remise (en %)" FontSize="14" />
                <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                    <handlers:BorderlessEntry Style="{StaticResource FormEntry}" Placeholder="Ex. : 20" Keyboard="Numeric" Text="{Binding PercentText}" />
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Du" Style="{StaticResource FormLabel}" />
                        <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                            <handlers:BorderlessDatePicker Style="{StaticResource FormDate}" Date="{Binding StartDate}" MinimumDate="{Binding MinStartDate}" Format="dd/MM/yyyy" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Au (inclus)" Style="{StaticResource FormLabel}" />
                        <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                            <handlers:BorderlessDatePicker Style="{StaticResource FormDate}" Date="{Binding EndDate}" MinimumDate="{Binding StartDate}" MaximumDate="{Binding MaxEndDate}" Format="dd/MM/yyyy" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Label Text="90 jours au plus." Style="{StaticResource UiBody}" FontSize="12" />

                <Label Text="Jours où la location commence" Style="{StaticResource FormLabel}" />
                <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-8" BindableLayout.ItemsSource="{Binding Weekdays}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="Statistique:StatsChoice">
                            <Border Style="{StaticResource Chip}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimary}" />
                                        <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.ToggleWeekdayCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding Code}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource UiTextPrimary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeOnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Label Text="La remise compte selon le jour où la location commence, à l'heure du magasin. Elle ne touche jamais la caution ni le supplément passagers."
                       Style="{StaticResource UiBody}" FontSize="12" />

                <Button Text="Voir l'aperçu" Command="{Binding ComputePreviewCommand}" HeightRequest="48" CornerRadius="12"
                        FontFamily="InterSemiBold" FontSize="15" BackgroundColor="{StaticResource UiSurface}" TextColor="{DynamicResource ThemePrimary}"
                        BorderColor="{DynamicResource ThemePrimary}" BorderWidth="1" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" HeightRequest="24" />

                <!-- Aperçu -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding HasPreview}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Preview.PeriodText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:RentalPromotionPreviewRow">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Name}" Style="{StaticResource UiTitle}" FontSize="14" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding ExampleText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource UiTextPrimary}" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" FontFamily="InterSemiBold" FontSize="12" TextColor="#B91C1C" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="Remise de plus de 50 % : vérifiez qu'elle reste rentable." IsVisible="{Binding Preview.HasBigDiscount}" FontFamily="InterSemiBold" FontSize="12" TextColor="#B45309" />
                        <Label Text="{Binding Preview.BlockingText}" IsVisible="{Binding Preview.HasBlocking}" FontFamily="InterSemiBold" FontSize="13" TextColor="#B91C1C" />
                    </VerticalStackLayout>
                </components:UiCard>

                <Button Text="Créer la promotion" Command="{Binding ApplyCommand}" IsVisible="{Binding CanApply}" HeightRequest="50" CornerRadius="14"
                        FontFamily="InterSemiBold" FontSize="16" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="{DynamicResource ThemeOnPrimary}" Margin="0,4,0,16" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
