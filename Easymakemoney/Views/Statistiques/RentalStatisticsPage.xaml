<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:Statistique="clr-namespace:Easymakemoney.ViewModels.Statistiques"
             x:DataType="Statistique:RentalStatisticsViewModel"
             x:Class="Easymakemoney.Views.Statistiques.RentalStatisticsPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Locations">

    <ContentPage.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
        </Style>
        <Style x:Key="FormField" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,2" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Locations" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-8" BindableLayout.ItemsSource="{Binding Ranges}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="Statistique:StatsChoice">
                            <Border Style="{StaticResource Chip}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimary}" />
                                        <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectRangeCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding Code}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource UiTextPrimary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeOnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Border Style="{StaticResource FormField}" IsVisible="{Binding ShowsPeriodPicker}">
                    <Picker Title="Choisir une période" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                            ItemDisplayBinding="{Binding nomCollection, x:DataType=models:ListCollection}"
                            FontFamily="Inter" FontSize="15" TextColor="{StaticResource UiTextPrimary}" BackgroundColor="Transparent" />
                </Border>

                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowsCustomDates}">
                    <Border Style="{StaticResource FormField}">
                        <DatePicker Date="{Binding CustomFrom}" Format="dd/MM/yyyy" FontFamily="Inter" FontSize="15" TextColor="{StaticResource UiTextPrimary}" BackgroundColor="Transparent" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FormField}">
                        <DatePicker Date="{Binding CustomTo}" Format="dd/MM/yyyy" FontFamily="Inter" FontSize="15" TextColor="{StaticResource UiTextPrimary}" BackgroundColor="Transparent" />
                    </Border>
                    <Button Grid.Column="2" Text="Afficher" Command="{Binding ApplyCustomDatesCommand}" CornerRadius="12" Padding="14,0"
                            FontFamily="InterSemiBold" FontSize="14" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="{DynamicResource ThemeOnPrimary}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Data.RangeText}" Style="{StaticResource UiBody}" FontSize="13" VerticalOptions="Center" />
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" HeightRequest="20" WidthRequest="20" />
                </Grid>

                <!-- Chiffres clés -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" IsVisible="{Binding HasData}">
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <components:UiTerm Term="revenu-location" Text="Revenu" FontSize="13" />
                            <Label Text="{Binding Data.RevenueText}" FontFamily="InterBold" FontSize="19" TextColor="{StaticResource UiTextPrimary}" />
                            <Label Text="à la date de vente" Style="{StaticResource UiBody}" FontSize="11" />
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Grid.Column="1" Style="{StaticResource UiCard}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <components:UiTerm Term="revenu-date-location" Text="Revenu loué" FontSize="13" />
                            <Label Text="{Binding Data.RevenueByRentalDateText}" FontFamily="InterBold" FontSize="19" TextColor="{StaticResource UiTextPrimary}" />
                            <Label Text="à la date de location" Style="{StaticResource UiBody}" FontSize="11" />
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Grid.Row="1" Style="{StaticResource UiCard}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Locations" FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource UiTextSecondary}" />
                            <Label Text="{Binding Data.RentalsText}" FontFamily="InterBold" FontSize="19" TextColor="{StaticResource UiTextPrimary}" />
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Grid.Row="1" Grid.Column="1" Style="{StaticResource UiCard}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Annulations" FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource UiTextSecondary}" />
                            <Label Text="{Binding Data.CancellationsText}" FontFamily="InterBold" FontSize="19" TextColor="{StaticResource UiTextPrimary}" />
                        </VerticalStackLayout>
                    </components:UiCard>
                </Grid>

                <!-- Jours de la semaine -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="8">
                        <components:UiTerm Term="occupation" Text="Occupation par jour de la semaine" FontSize="15" FontFamily="InterBold" />
                        <components:StatsChartView Points="{Binding WeekdayPoints}" IsPercent="True" IsMoney="False"
                                                   SelectedIndex="{Binding SelectedDayIndex, Mode=TwoWay}" HeightRequest="180" />
                        <Label Text="{Binding SelectedDayText}" Style="{StaticResource UiBody}" FontSize="12" />
                        <Label Text="{Binding Data.HighDaysText}" IsVisible="{Binding Data.HasHighDays}" FontFamily="InterSemiBold" FontSize="13" TextColor="#047857" />
                        <Label Text="{Binding Data.LowDaysText}" IsVisible="{Binding Data.HasLowDays}" FontFamily="InterSemiBold" FontSize="13" TextColor="#B45309" />
                    </VerticalStackLayout>
                </components:UiCard>

                <!-- Articles -->
                <Label Text="Par article" Style="{StaticResource UiTitle}" FontSize="17" IsVisible="{Binding Data.HasProducts}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Products}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:RentalProductRow">
                            <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Name}" Style="{StaticResource UiTitle}" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding RevenueText}" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource UiTextPrimary}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <ProgressBar Progress="{Binding Occupancy}" ProgressColor="{Binding ToneColor}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding OccupancyText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{Binding ToneColor}" />
                                    </Grid>
                                    <Label Text="{Binding DetailText}" Style="{StaticResource UiBody}" FontSize="12" />
                                    <Label Text="{Binding TimeText}" IsVisible="{Binding HasTime}" Style="{StaticResource UiBody}" FontSize="11" />
                                </VerticalStackLayout>
                            </components:UiCard>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Aucun article en location sur cette plage." IsVisible="{Binding HasData}" Style="{StaticResource UiBody}" FontSize="14">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Data.HasProducts}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Label Text="{Binding Data.CaveatsText}" IsVisible="{Binding Data.HasCaveats}" Style="{StaticResource UiBody}" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
