<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:Statistique="clr-namespace:Easymakemoney.ViewModels.Statistiques"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             x:DataType="Statistique:FraisEvolutionEntrepriseViewModel"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="Easymakemoney.Views.Statistiques.FraisEvolutionEntreprisePage"
             Style="{StaticResource UiPage}"
             Title="Frais">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Frais"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Button Text="Période"
                        Command="{Binding ShowBottomSheetPopupListViewCommand}"
                        BackgroundColor="{DynamicResource ThemePrimaryTint}"
                        TextColor="{DynamicResource ThemePrimary}"
                        FontFamily="InterSemiBold"
                        FontSize="14"
                        CornerRadius="12"
                        MinimumHeightRequest="44"
                        Padding="20,0"
                        HorizontalOptions="Start"/>
                <components:BudgetOverviewView
                    IconSource="revenue.png"
                    HeaderText="Valeur des frais de l’entreprise"
                    TotalLabelText="Frais total"
                    TotalValue="{Binding TotalFraisAnnee, Converter={StaticResource CurrencyConverter}}"
                    ExpensesLabelText="Note de frais"
                    ExpensesValue="{Binding NoteDeFraisAnnee, Converter={StaticResource CurrencyConverter}}"
                    RemainingLabelText="Frais de port"
                    IsExpensesVisible="True"
                    RemainingValue="{Binding FraisDePortAnnee,Converter={StaticResource CurrencyConverter}}"/>
                <Label Text="{Binding PeriodeFrais}" Style="{StaticResource UiTitle}"/>
                <components:UiCard Style="{StaticResource UiCard}" Padding="16,4">
                    <CollectionView ItemsSource="{Binding AllFraisValue}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Padding="0,10">
                                <Label Text="Période" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource UiTextMuted}" HorizontalTextAlignment="Start" Grid.Column="0"/>
                                <Label Text="Total" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource UiTextMuted}" HorizontalTextAlignment="End" Grid.Column="1"/>
                                <Label Text="Note de frais" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource UiTextMuted}" HorizontalTextAlignment="End" Grid.Column="2"/>
                                <Label Text="Frais de port" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource UiTextMuted}" HorizontalTextAlignment="End" Grid.Column="3"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x1:IFraisData">
                                <Grid RowDefinitions="Auto,Auto"
                                      BackgroundColor="{Binding BackgroundColor}">
                                    <Grid ColumnDefinitions="*,*,*,*"
                                          ColumnSpacing="8"
                                          MinimumHeightRequest="44">
                                        <Label Text="{Binding PeriodLabel}"
                                               Style="{StaticResource UiBody}"
                                               VerticalTextAlignment="Center"
                                               Grid.Column="0"/>
                                        <Label Text="{Binding TotalFrais.Total, Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="InterSemiBold"
                                               FontSize="13"
                                               TextColor="{DynamicResource ThemePrimary}"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center"
                                               Grid.Column="1"/>
                                        <Label Text="{Binding TotalFrais.NoteDeFrais, Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="InterSemiBold"
                                               FontSize="13"
                                               TextColor="{StaticResource UiTextPrimary}"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center"
                                               Grid.Column="2"/>
                                        <Label Text="{Binding TotalFrais.FraisDePort, Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="InterSemiBold"
                                               FontSize="13"
                                               TextColor="{StaticResource UiTextPrimary}"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center"
                                               Grid.Column="3"/>
                                    </Grid>
                                    <BoxView Grid.Row="1" HeightRequest="1" Color="#F1F5F9"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </components:UiCard>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
