<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:Statistique="clr-namespace:Easymakemoney.ViewModels.Statistiques"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             x:DataType="Statistique:TransactionCaisseViewModel"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="Easymakemoney.Views.Statistiques.TransactionCaissePage"
             Style="{StaticResource UiPage}"
             Title="Caisse">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Caisse"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Transactions de la caisse" Style="{StaticResource UiTitle}"/>
                <components:UiCard Style="{StaticResource UiCard}" Padding="16,4">
                    <CollectionView ItemsSource="{Binding AllTransactions}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="0,10">
                                <Label Text="Montant" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource UiTextMuted}" HorizontalTextAlignment="Start" Grid.Column="0"/>
                                <Label Text="Date" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource UiTextMuted}" HorizontalTextAlignment="Center" Grid.Column="1"/>
                                <Label Text="Type" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource UiTextMuted}" HorizontalTextAlignment="End" Grid.Column="2"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x1:TransactionCaisse">
                                <Grid RowDefinitions="Auto,Auto"
                                      BackgroundColor="{Binding BackgroundColor}">
                                    <Grid ColumnDefinitions="*,*,*"
                                          ColumnSpacing="8"
                                          MinimumHeightRequest="44">
                                        <Label Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                               FontFamily="InterSemiBold"
                                               FontSize="13"
                                               TextColor="{DynamicResource ThemePrimary}"
                                               HorizontalTextAlignment="Start"
                                               VerticalTextAlignment="Center"
                                               Grid.Column="0"/>
                                        <Label Text="{Binding TransactionDate}"
                                               FontFamily="InterSemiBold"
                                               FontSize="13"
                                               TextColor="{StaticResource UiTextPrimary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               Grid.Column="1"/>
                                        <Label Text="{Binding TransactionType}"
                                               FontFamily="InterSemiBold"
                                               FontSize="13"
                                               TextColor="{StaticResource UiTextPrimary}"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center"
                                               Grid.Column="2"/>
                                    </Grid>
                                    <BoxView Grid.Row="1" HeightRequest="1" Color="#F1F5F9"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </components:UiCard>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
