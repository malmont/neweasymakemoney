<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             xmlns:Statistique="clr-namespace:Easymakemoney.ViewModels.Statistiques"
             x:DataType="Statistique:StatistiquesViewModel"
             x:Class="Easymakemoney.Views.Statistiques.StatistiquesPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Statistiques">

    <ContentPage.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
        </Style>
        <Style x:Key="ChipText" TargetType="Label">
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
        </Style>
        <Style x:Key="FormField" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
            <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,2" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader Title="Statistiques"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <components:UiTile Command="{Binding NavigateToYearCommand}" Icon="M4 20V10M10 20V4M16 20v-7M22 20H2" Title="L'année de l'entreprise" Text="Mois par mois, rentabilité, ce qui manque et les leviers" />
                <components:UiTile Command="{Binding NavigateToRentalsCommand}" Icon="M4 7h16v13H4zM8 3v4M16 3v4M4 11h16" Title="Locations" Text="Occupation par article et par jour, revenu des locations" />

                <!-- Plage -->
                <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-8" BindableLayout.ItemsSource="{Binding Ranges}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="Statistique:StatsChoice">
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimary}" />
                                            <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectRangeCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding Code}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}" Style="{StaticResource ChipText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource ThemeOnPrimary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Border Style="{StaticResource FormField}" IsVisible="{Binding ShowsPeriodPicker}">
                    <Picker Title="Choisir une période" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                            ItemDisplayBinding="{Binding nomCollection, x:DataType=models:ListCollection}"
                            FontFamily="Inter" FontSize="15" TextColor="{StaticResource UiTextPrimary}" BackgroundColor="Transparent" />
                </Border>

                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowsCustomDates}">
                    <Border Style="{StaticResource FormField}">
                        <DatePicker Date="{Binding CustomFrom}" Format="dd/MM/yyyy" FontFamily="Inter" FontSize="15" TextColor="{StaticResource UiTextPrimary}" BackgroundColor="Transparent" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FormField}">
                        <DatePicker Date="{Binding CustomTo}" Format="dd/MM/yyyy" FontFamily="Inter" FontSize="15" TextColor="{StaticResource UiTextPrimary}" BackgroundColor="Transparent" />
                    </Border>
                    <Button Grid.Column="2" Text="Afficher" Command="{Binding ApplyCustomDatesCommand}" CornerRadius="12" Padding="14,0"
                            FontFamily="InterSemiBold" FontSize="14" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="{DynamicResource ThemeOnPrimary}" />
                </Grid>

                <!-- Canal -->
                <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-8" BindableLayout.ItemsSource="{Binding Sources}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="Statistique:StatsChoice">
                                <Border Style="{StaticResource Chip}" Padding="12,6" Margin="0,0,8,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimaryTint}" />
                                            <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectSourceCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding Code}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}" Style="{StaticResource ChipText}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding ComparisonText}" Style="{StaticResource UiBody}" FontSize="13" VerticalOptions="Center" />
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ThemePrimary}" HeightRequest="20" WidthRequest="20" />
                </Grid>

                <!-- Indicateurs -->
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding CardRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:StatsCardRow">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <components:StatsCardView BindingContext="{Binding Left}" />
                                <ContentView Grid.Column="1" IsVisible="{Binding HasRight}">
                                    <components:StatsCardView BindingContext="{Binding Right}" />
                                </ContentView>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Graphique -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="10">
                        <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-8" BindableLayout.ItemsSource="{Binding Metrics}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="Statistique:StatsChoice">
                                    <Border Style="{StaticResource Chip}" Padding="12,6" Margin="0,0,8,8">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimaryTint}" />
                                                <Setter Property="Stroke" Value="{DynamicResource ThemePrimary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectMetricCommand, Source={x:Reference Page}, x:DataType=ContentPage}" CommandParameter="{Binding Code}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" Style="{StaticResource ChipText}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <components:StatsChartView Points="{Binding ChartPoints}" IsMoney="{Binding ChartIsMoney}" Currency="{Binding Currency}"
                                                   SelectedIndex="{Binding SelectedPointIndex, Mode=TwoWay}" HeightRequest="210" />
                        <Label Text="{Binding SelectedPointText}" Style="{StaticResource UiBody}" FontSize="12" />
                    </VerticalStackLayout>
                </components:UiCard>

                <!-- Autres revenus -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding HasOtherRevenue}">
                    <VerticalStackLayout Spacing="8">
                        <components:UiTerm Term="autres-revenus" Text="Locations et abonnements" FontSize="14" />
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding OtherRevenue}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:StatsOtherRevenueRow">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                        <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ChangeText}" Style="{StaticResource UiBody}" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </components:UiCard>

                <Label Text="{Binding CaveatsText}" IsVisible="{Binding HasCaveats}" Style="{StaticResource UiBody}" FontSize="12" />

                <!-- Volet « Paiements et caisse » (lot S2-a) -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasPayments}">
                    <components:UiTerm Term="encaisse" Text="Paiements et caisse" FontSize="17" Margin="0,8,0,0" />
                    <Label Text="L'argent reçu et rendu, par moyen de paiement, et les clôtures de la caisse." Style="{StaticResource UiBody}" FontSize="12" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Payments.CardRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StatsCardRow">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <components:StatsCardView BindingContext="{Binding Left}" />
                                    <ContentView Grid.Column="1" IsVisible="{Binding HasRight}">
                                        <components:StatsCardView BindingContext="{Binding Right}" />
                                    </ContentView>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Payments.HasRows}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Payments.RowsTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Payments.Rows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Payments.HasExtra}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Payments.ExtraTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Payments.ExtraRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Payments.HasCredit}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Payments.CreditTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Payments.CreditRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <Label Text="{Binding Payments.CaveatsText}" IsVisible="{Binding Payments.HasCaveats}" Style="{StaticResource UiBody}" FontSize="12" />
                </VerticalStackLayout>

                <!-- Volet « Frais » (lot S2-a) -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasExpenses}">
                    <components:UiTerm Term="frais" Text="Frais" FontSize="17" Margin="0,8,0,0" />
                    <Label Text="Notes de frais, port payé aux fournisseurs et publicité : le même total que dans le résultat de période." Style="{StaticResource UiBody}" FontSize="12" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Expenses.CardRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StatsCardRow">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <components:StatsCardView BindingContext="{Binding Left}" />
                                    <ContentView Grid.Column="1" IsVisible="{Binding HasRight}">
                                        <components:StatsCardView BindingContext="{Binding Right}" />
                                    </ContentView>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Expenses.HasRows}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Expenses.RowsTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Expenses.Rows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Expenses.HasExtra}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Expenses.ExtraTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Expenses.ExtraRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <Label Text="{Binding Expenses.CaveatsText}" IsVisible="{Binding Expenses.HasCaveats}" Style="{StaticResource UiBody}" FontSize="12" />
                </VerticalStackLayout>

                <!-- Volet « Stock » (lot S2-b) -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasStock}">
                    <components:UiTerm Term="valeur-stock" Text="Stock" FontSize="17" Margin="0,8,0,0" />
                    <Label Text="Les mouvements de la plage (toutes ventes confondues), puis la valeur du stock aujourd'hui." Style="{StaticResource UiBody}" FontSize="12" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Stock.CardRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StatsCardRow">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <components:StatsCardView BindingContext="{Binding Left}" />
                                    <ContentView Grid.Column="1" IsVisible="{Binding HasRight}">
                                        <components:StatsCardView BindingContext="{Binding Right}" />
                                    </ContentView>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Stock.HasRows}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Stock.RowsTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Stock.Rows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Stock.HasExtra}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Stock.ExtraTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Stock.ExtraRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <Label Text="{Binding Stock.CaveatsText}" IsVisible="{Binding Stock.HasCaveats}" Style="{StaticResource UiBody}" FontSize="12" />
                </VerticalStackLayout>

                <!-- Volet « Livraison » (lot S2-b) -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasShipping}">
                    <components:UiTerm Term="port-facture" Text="Livraison" FontSize="17" Margin="0,8,0,0" />
                    <Label Text="Le port facturé aux clients, par transporteur." Style="{StaticResource UiBody}" FontSize="12" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Shipping.CardRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StatsCardRow">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <components:StatsCardView BindingContext="{Binding Left}" />
                                    <ContentView Grid.Column="1" IsVisible="{Binding HasRight}">
                                        <components:StatsCardView BindingContext="{Binding Right}" />
                                    </ContentView>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Shipping.HasRows}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Shipping.RowsTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Shipping.Rows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Shipping.HasExtra}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Shipping.ExtraTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Shipping.ExtraRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <Label Text="{Binding Shipping.CaveatsText}" IsVisible="{Binding Shipping.HasCaveats}" Style="{StaticResource UiBody}" FontSize="12" />
                </VerticalStackLayout>

                <!-- Volet « Taxes » (lot S2-b) -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasTaxes}">
                    <components:UiTerm Term="taxes-collectees" Text="Taxes" FontSize="17" Margin="0,8,0,0" />
                    <Label Text="Les taxes collectées, nettes des retours, taxe par taxe." Style="{StaticResource UiBody}" FontSize="12" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Taxes.CardRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StatsCardRow">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <components:StatsCardView BindingContext="{Binding Left}" />
                                    <ContentView Grid.Column="1" IsVisible="{Binding HasRight}">
                                        <components:StatsCardView BindingContext="{Binding Right}" />
                                    </ContentView>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Taxes.HasRows}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Taxes.RowsTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Taxes.Rows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding Taxes.HasExtra}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Taxes.ExtraTitle}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Taxes.ExtraRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatsSectionRow">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Title}" Style="{StaticResource UiBody}" FontSize="14" />
                                            <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource UiBody}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </components:UiCard>
                    <Label Text="{Binding Taxes.CaveatsText}" IsVisible="{Binding Taxes.HasCaveats}" Style="{StaticResource UiBody}" FontSize="12" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
