<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Dashboard"
             x:DataType="list:DashBoardProductViewModel"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Easymakemoney.Views.Dasboard.DashBoardProductPage"
             Style="{StaticResource UiPage}"
             Title="Produit">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
            <converters:PercentageConverter x:Key="PercentageConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:FirstItemNameConverter x:Key="FirstItemNameConverter"/>
            <converters:FirstLetterConverter x:Key="FirstLetterConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <components:AppHeader Title="Produit"/>

        <components:NavbarContentView Grid.Row="1"
                                      ButtonText="Listes"
                                      ButtonCommand="{Binding ShowBottomSheetPopupListProductViewCommand}"
                                      ImageButtonSourceList="{Binding ProductImage}"
                                      ImageButtonSource="boutonaddblanc64.png"
                                      ImageButtonCommand="{Binding ShowBottomSheetCreateProductCommand}"
                                      LabelText="Produit"
                                      PlaceholderText="Choisir un produit"
                                      Icon="M20 12l-8 8-9-9V3h8l9 9zM7.5 7.5h.01"
                                      ValueText="{Binding ProductName}"/>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Tableau de bord produit" Style="{StaticResource UiTitle}"/>

                <components:UiCard Style="{StaticResource UiCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nom" Style="{StaticResource UiBody}"/>
                        <Label Text="{Binding DashBoardProduct.name}"
                               FontFamily="InterBold"
                               FontSize="22"
                               TextColor="{StaticResource UiTextPrimary}"/>
                    </VerticalStackLayout>
                </components:UiCard>

                <components:TitreComponent
                    Icon="M5 3v18l3-2 2 2 2-2 2 2 2-2 3 2V3l-3 2-2-2-2 2-2-2-2 2-3-2zM8 9h8M8 13h8"
                    IsExpensesVisible="False"
                    HeaderText="Commentaire"/>
                <components:UiCard Style="{StaticResource UiCard}">
                    <Label Text="{Binding DashBoardProduct.moreinformations}" Style="{StaticResource UiBody}" FontSize="14"/>
                </components:UiCard>
                <components:BudgetOverviewView
                    Icon="M6 2h12a2 2 0 012 2v16a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2zM8 6h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01"
                    HeaderText="Budget général"
                    TotalLabelText="Prix"
                    TotalValue="{Binding DashBoardProduct.price, Converter={StaticResource CurrencyConverter}}"
                    ExpensesLabelText="Prix d’achat"
                    ExpensesValue="{Binding DashBoardProduct.purchasePrice, Converter={StaticResource CurrencyConverter}}"
                    RemainingLabelText="Coefficient"
                    IsExpensesVisible="True"
                    RemainingValue="{Binding DashBoardProduct.coefficientMultiplier}"/>
                <components:TitreComponent
                    Icon="M3 5v14M7 5v14M11 5v14M15 5v14M18 5v14M21 5v14"
                    IsExpensesVisible="False"
                    HeaderText="Code-barres"/>
                <components:UiCard Style="{StaticResource UiCard}">
                    <Label Text="{Binding DashBoardProduct.barcode}" Style="{StaticResource UiBody}" FontSize="14"/>
                </components:UiCard>
                <components:UiCard Style="{StaticResource UiCard}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <components:StatusBadgeView Name="Meilleure vente"
                                                    IsActive="{Binding DashBoardProduct.isbestseller}"/>
                        <components:StatusBadgeView Grid.Column="1"
                                                    Name="Nouveauté"
                                                    IsActive="{Binding DashBoardProduct.isnewarrival}"/>
                        <components:StatusBadgeView Grid.Row="1"
                                                    Name="Mis en avant"
                                                    IsActive="{Binding DashBoardProduct.isfeatured}"/>
                        <components:StatusBadgeView Grid.Row="1"
                                                    Grid.Column="1"
                                                    Name="Offre spéciale"
                                                    IsActive="{Binding DashBoardProduct.isspecialoffer}"/>
                    </Grid>
                </components:UiCard>

                <components:UiCard Style="{StaticResource UiCard}">
                    <Image Source="{Binding DashBoardProduct.image}"
                           HeightRequest="200"
                           WidthRequest="200"
                           HorizontalOptions="Center"/>
                </components:UiCard>

                <components:TitreComponent
                    Icon="M3 5v14M7 5v14M11 5v14M15 5v14M18 5v14M21 5v14"
                    HeaderText="Stock commandé"
                    Value="{Binding DisplayedQuantity}"/>
                <components:TitreComponent
                    Icon="M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z"
                    HeaderText="Créé le"
                    Value="{Binding DashBoardProduct.createdAt}"/>
                <components:TitreComponent
                    Icon="M20 12l-8 8-9-9V3h8l9 9zM7.5 7.5h.01"
                    HeaderText="Style"
                    Value="{Binding DashBoardProduct.style.name}"/>
                <components:TitreComponent
                    Icon="M20 12l-8 8-9-9V3h8l9 9zM7.5 7.5h.01"
                    HeaderText="Catégorie"
                    Value="{Binding DashBoardProduct.category, Converter={StaticResource FirstItemNameConverter}}"/>
                <components:TitreComponent
                    Icon="M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4"
                    HeaderText="Stock en cours"
                    Value="{Binding DashBoardProduct.quantity}"
                    IsExpensesVisible="True"/>

                <CollectionView ItemsSource="{Binding DashBoardProduct.variants}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="3"
                                         HorizontalItemSpacing="8"
                                         VerticalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x1:ProductVariant">
                            <components:UiCard Style="{StaticResource UiCard}" Padding="10">
                                <VerticalStackLayout Spacing="6">
                                    <!-- Couleur -->
                                    <Border HeightRequest="20"
                                            Stroke="{StaticResource UiBorder}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 5"
                                            BackgroundColor="{Binding color.codeHexa}"/>

                                    <!-- Taille -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <Label Text="Taille :" Style="{StaticResource UiBody}"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding size.name, Converter={StaticResource FirstLetterConverter}}"
                                               FontFamily="InterSemiBold"
                                               FontSize="13"
                                               TextColor="{StaticResource UiTextPrimary}"/>
                                    </Grid>

                                    <!-- Stock -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <Label Text="Stock :" Style="{StaticResource UiBody}"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding stockQuantity}"
                                               FontFamily="InterSemiBold"
                                               FontSize="13"
                                               TextColor="{StaticResource UiTextPrimary}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </components:UiCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
