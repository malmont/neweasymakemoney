<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dashboard="clr-namespace:Easymakemoney.ViewModels.Dashboard"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:models="clr-namespace:Easymakemoney.Models"
             x:DataType="dashboard:DashboardPageViewModel"
             x:Class="Easymakemoney.Views.Dasboard.DashboardPage"
             x:Name="Page"
             Style="{StaticResource UiPage}"
             Title="Accueil">

    <Grid RowDefinitions="Auto,*">
        <components:AppHeader IsRoot="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,24" Spacing="12">
                <Label Text="Accueil" Style="{StaticResource UiH1}" Margin="0,0,0,8" />

                <!-- Sans réseau : la dernière copie de l'Accueil, datée -->
                <Border IsVisible="{Binding IsOffline}" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#FEF3C7" Padding="12,8">
                    <Label Text="{Binding OfflineText}" FontFamily="InterSemiBold" FontSize="13" TextColor="#92400E" />
                </Border>

                <!-- Lot JOUR : « Ma journée », chiffres du serveur ; cachée tant que la route n'existe pas -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="16" IsVisible="{Binding HasDay}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ma journée" FontFamily="InterSemiBold" FontSize="12" TextColor="{DynamicResource ThemePrimary}" />
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDayCommand}" CommandParameter="sales" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Day.SalesText}" Style="{StaticResource UiTitle}" FontSize="18" />
                            <Label Text="{Binding Day.SalesTrendText}" IsVisible="{Binding Day.HasSalesTrend}" FontFamily="InterMedium" FontSize="12" TextColor="{StaticResource UiTextSecondary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Day.IsSalesUp}" Value="True">
                                        <Setter Property="TextColor" Value="#15803D" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Day.IsSalesDown}" Value="True">
                                        <Setter Property="TextColor" Value="#B45309" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource UiBorder}" />
                        <Label Text="{Binding Day.ToShipText}" Style="{StaticResource UiBody}" FontSize="14" />
                        <Label Text="{Binding Day.SupportText}" IsVisible="{Binding Day.HasSupport}" Style="{StaticResource UiBody}" FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDayCommand}" CommandParameter="support" />
                            </Label.GestureRecognizers>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Day.IsSupportLate}" Value="True">
                                    <Setter Property="TextColor" Value="#B91C1C" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <VerticalStackLayout Spacing="0" IsVisible="{Binding Day.HasCash}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDayCommand}" CommandParameter="cash" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Day.CashText}" Style="{StaticResource UiBody}" FontSize="14" />
                            <Label Text="{Binding Day.CashLowText}" FontFamily="Inter" FontSize="12" TextColor="{StaticResource UiTextSecondary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Day.IsCashWarning}" Value="True">
                                        <Setter Property="TextColor" Value="#B91C1C" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <Label Text="{Binding Day.StockText}" Style="{StaticResource UiBody}" FontSize="14">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Day.HasLowStock}" Value="True">
                                    <Setter Property="TextColor" Value="#B45309" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </components:UiCard>

                <!-- Lot CHE : « Préparer ma gestion » tant que la configuration n'est pas complète -->
                <components:UiCard Style="{StaticResource UiCard}" Padding="14" IsVisible="{Binding HasReadinessCard}">
                    <components:UiCard.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenReadinessCommand}" />
                    </components:UiCard.GestureRecognizers>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Préparer ma gestion" FontFamily="InterSemiBold" FontSize="12" TextColor="{DynamicResource ThemePrimary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsReadinessAlert}" Value="True">
                                    <Setter Property="TextColor" Value="#B91C1C" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding ReadinessCardText}" Style="{StaticResource UiTitle}" FontSize="16" />
                        <Label Text="Voir les étapes →" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource ThemePrimary}" />
                    </VerticalStackLayout>
                </components:UiCard>

                <!-- Vignettes d'accueil : premiers pas et alertes, les plus urgentes d'abord -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasTiles}" Margin="0,0,0,8"
                                     BindableLayout.ItemsSource="{Binding Tiles}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:HomeTile">
                            <components:UiCard Style="{StaticResource UiCard}" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.OpenTileCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <components:UiThumb Grid.Column="0" Icon="{Binding Icon}" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding KindText}" FontFamily="InterSemiBold" FontSize="12" TextColor="{DynamicResource ThemePrimary}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsAlert}" Value="True">
                                                    <Setter Property="TextColor" Value="#B45309" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding title}" Style="{StaticResource UiTitle}" FontSize="16" />
                                        <Label Text="{Binding text}" Style="{StaticResource UiBody}" FontSize="14" />
                                        <Label Text="{Binding SourcesText}" IsVisible="{Binding HasSources}" Style="{StaticResource UiBody}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="✕" VerticalOptions="Start"
                                            IsVisible="{Binding dismissible}"
                                            Command="{Binding Path=BindingContext.DismissTileCommand, Source={x:Reference Page}, x:DataType=ContentPage}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Masquer cette vignette"
                                            WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="18"
                                            FontSize="14" BackgroundColor="Transparent" TextColor="{StaticResource UiTextMuted}" />
                                </Grid>
                            </components:UiCard>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <components:UiTile Command="{Binding OpenGuideCommand}" Icon="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z" Title="Guide de la période" Text="Conseils chiffrés pour rendre la période rentable" />
                <components:UiTile Command="{Binding NavigateToAllListsPageCommand}" Icon="M4 6h16M4 12h16M4 18h10" Title="Gestion" Text="Périodes, fournisseurs, notes de frais et frais de port" />
                <components:UiTile Command="{Binding NavigateTDashboardPageCommand}" Icon="M4 20V10M10 20V4M16 20v-7M22 20H2" Title="Tableau de bord" Text="Budget, dépenses et durée de chaque période" />
                <components:UiTile Command="{Binding NavigateToStatistiquesPageCommand}" Icon="M3 17l6-6 4 4 8-8M15 7h6v6" Title="Statistiques" Text="Chiffre d’affaires, achats, panier, stock, frais et caisse" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
