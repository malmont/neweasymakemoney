<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:list="clr-namespace:Easymakemoney.ViewModels.Dashboard"
             x:DataType="list:DashBoardCollectionViewModel"
             xmlns:x1="clr-namespace:Easymakemoney.Models"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             xmlns:converters="clr-namespace:Easymakemoney.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Easymakemoney.Views.Dasboard.DashBoardCollectionPage"
             Style="{StaticResource UiPage}"
             Title="Tableau de bord">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CurrencyConverter x:Key="CurrencyConverter"/>
            <converters:PercentageConverter x:Key="PercentageConverter"/>
            <converters:IsoDateConverter x:Key="IsoDateConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <components:AppHeader Title="Tableau de bord"/>

        <components:NavbarContentView Grid.Row="1"
                                      ButtonText="Listes"
                                      ButtonCommand="{Binding ShowBottomSheetPopupListViewCommand}"
                                      ImageButtonSourceList="{Binding CollectionImage}"
                                      ImageButtonSource="boutonaddblanc64.png"
                                      ImageButtonCommand="{Binding ShowBottomSheetCreateListCommand}"
                                      ImageButtonCommandList="{Binding ItemTappedCommand}"
                                      HideCreate="True"
                                      LabelText="Période"
                                      PlaceholderText="Choisir une période"
                                      Icon="M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4"
                                      ValueText="{Binding CollectionName}"/>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16" Spacing="12">
                <VerticalStackLayout IsVisible="{Binding IsClosedVisible}" Spacing="8">
                    <!-- Bouton de clôture : seules les collections manuelles se clôturent à la main -->
                    <Button Text="{Binding CloseButtonText}"
                            IsVisible="{Binding CanClose}"
                            BackgroundColor="{DynamicResource ThemePrimary}"
                            TextColor="{DynamicResource ThemeOnPrimary}"
                            FontFamily="InterSemiBold"
                            FontSize="15"
                            CornerRadius="12"
                            MinimumHeightRequest="48"
                            Command="{Binding CloseCollectionCommand}" />

                    <Label Text="Période clôturée"
                           IsVisible="{Binding IsClosed}"
                           Style="{StaticResource UiTitle}"
                           TextColor="#B91C1C"
                           HorizontalOptions="Center" />

                    <Button Text="Rouvrir la période"
                            IsVisible="{Binding CanReopen}"
                            BackgroundColor="{DynamicResource ThemePrimary}"
                            TextColor="{DynamicResource ThemeOnPrimary}"
                            FontFamily="InterSemiBold"
                            FontSize="15"
                            CornerRadius="12"
                            MinimumHeightRequest="48"
                            Command="{Binding ReopenCollectionCommand}" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasPeriodResult}" Spacing="10">
                    <components:UiCard Style="{StaticResource UiCard}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Résultat de la période" Style="{StaticResource UiBody}" />
                                <Label Grid.Column="1" Text="Chiffres figés" IsVisible="{Binding PeriodResult.frozen}" Style="{StaticResource UiBody}" FontFamily="InterSemiBold" />
                            </Grid>
                            <Label Text="{Binding PeriodResult.NetText}" FontFamily="InterBold" FontSize="30" TextColor="{DynamicResource ThemePrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding PeriodResult.IsLoss}" Value="True">
                                        <Setter Property="TextColor" Value="#B91C1C" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding PeriodResult.NetRateText}" IsVisible="{Binding PeriodResult.HasNetRate}" FontFamily="InterSemiBold" FontSize="13" TextColor="#15803D">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding PeriodResult.IsLoss}" Value="True">
                                        <Setter Property="TextColor" Value="#B91C1C" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <components:UiAmountRow Title="Ventes d'articles" Value="{Binding PeriodResult.RevenueText}" />
                            <components:UiAmountRow Title="Ventes sans coût connu" Value="{Binding PeriodResult.UnknownRevenueText}" IsVisible="{Binding PeriodResult.HasUnknownRevenue}" />
                            <components:UiAmountRow Title="Coût des articles vendus" Value="{Binding PeriodResult.CogsText}" />
                            <Label Text="{Binding PeriodResult.EstimatedCogsText}" IsVisible="{Binding PeriodResult.HasEstimatedCogs}" Style="{StaticResource UiBody}" HorizontalOptions="End" />
                            <components:UiAmountRow Title="Marge" Value="{Binding PeriodResult.GrossText}" IsTotal="True" />
                            <components:UiAmountRow Title="Frais de port" Value="{Binding PeriodResult.ShippingText}" />
                            <components:UiAmountRow Title="Notes de frais" Value="{Binding PeriodResult.NotesText}" />
                            <components:UiAmountRow Title="Autres frais" Value="{Binding PeriodResult.OtherExpensesText}" IsVisible="{Binding PeriodResult.HasOtherExpenses}" />
                            <components:UiAmountRow Title="Résultat" Value="{Binding PeriodResult.NetText}" IsTotal="True" />
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Style="{StaticResource UiCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Investi en stock pendant la période" Style="{StaticResource UiBody}" />
                            <Label Text="{Binding PeriodResult.InvestmentText}" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}" />
                        </VerticalStackLayout>
                    </components:UiCard>
                    <components:UiCard Style="{StaticResource UiCard}" IsVisible="{Binding PeriodResult.HasUnknownCost}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding PeriodResult.UnknownCostTitle}" Style="{StaticResource UiTitle}" FontSize="15" TextColor="#B45309" />
                            <Label Text="{Binding PeriodResult.UnknownCostDetail}" Style="{StaticResource UiBody}" />
                        </VerticalStackLayout>
                    </components:UiCard>
                    <Grid ColumnDefinitions="*,Auto" Padding="4,0" IsVisible="{Binding PeriodResult.HasOtherRevenue}">
                        <Label Text="Autres revenus (location, abonnement)" Style="{StaticResource UiBody}" />
                        <Label Grid.Column="1" Text="{Binding PeriodResult.OtherRevenueText}" Style="{StaticResource UiBody}" />
                    </Grid>
                </VerticalStackLayout>

                <Label Text="Tableau de bord principal" Style="{StaticResource UiTitle}"/>

                <components:BudgetOverviewView
                    Icon="M6 2h12a2 2 0 012 2v16a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2zM8 6h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01"
                    HeaderText="Budget général"
                    TotalLabelText="Total"
                    TotalValue="{Binding DashBoardCollection.budgetGeneral.generalBudget, Converter={StaticResource CurrencyConverter}}"
                    ExpensesLabelText="Dépenses"
                    ExpensesValue="{Binding DashBoardCollection.budgetGeneral.usedBudget, Converter={StaticResource CurrencyConverter}}"
                    RemainingLabelText="Reste"
                    IsExpensesVisible="True"
                    RemainingValue="{Binding DashBoardCollection.budgetGeneral.remainingBudget, Converter={StaticResource CurrencyConverter}}"/>
                <components:UiCard Style="{StaticResource UiCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <components:UiGlyph Data="M6 6l12 12M18 6L6 18" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Coefficient moyen"
                                   Style="{StaticResource UiBody}"/>
                            <Label Text="{Binding DashBoardCollection.averageMultiplier}"
                                   FontFamily="InterBold"
                                   FontSize="22"
                                   TextColor="{StaticResource UiTextPrimary}"/>
                        </VerticalStackLayout>
                    </Grid>
                </components:UiCard>
                <components:BudgetOverviewView
                    Icon="M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z"
                    HeaderText="Durée de la période"
                    TotalLabelText="Début"
                    TotalValue="{Binding DashBoardCollection.collectionDuration.startDate, Converter={StaticResource IsoDateConverter}}"
                    ExpensesLabelText="Fin"
                    ExpensesValue="{Binding DashBoardCollection.collectionDuration.endDate, Converter={StaticResource IsoDateConverter}}"
                    RemainingLabelText="Durée"
                    IsExpensesVisible="True"
                    RemainingValue="{Binding DashBoardCollection.collectionDuration.days, StringFormat='{0} jours'}"/>
                <components:UiCard Style="{StaticResource UiCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <components:UiGlyph Data="M20 12l-8 8-9-9V3h8l9 9zM7.5 7.5h.01" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Coût des articles"
                                   Style="{StaticResource UiBody}"/>
                            <Label Text="{Binding DashBoardCollection.totalItemCost, Converter={StaticResource CurrencyConverter}}"
                                   FontFamily="InterBold"
                                   FontSize="22"
                                   TextColor="{StaticResource UiTextPrimary}"/>
                        </VerticalStackLayout>
                    </Grid>
                </components:UiCard>
                <components:BudgetOverviewView
                    Icon="M6 2h12a2 2 0 012 2v16a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2zM8 6h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01"
                    HeaderText="Frais généraux"
                    TotalLabelText="Total"
                    TotalValue="{Binding DashBoardCollection.generalExpenses.totalGeneralExpenses, Converter={StaticResource CurrencyConverter}}"
                    ExpensesLabelText="Port"
                    ExpensesValue="{Binding DashBoardCollection.generalExpenses.totalShippingCost, Converter={StaticResource CurrencyConverter}}"
                    RemainingLabelText="Divers"
                    IsExpensesVisible="True"
                    RemainingValue="{Binding DashBoardCollection.generalExpenses.totalExpenseCost, Converter={StaticResource CurrencyConverter}}"/>
                <components:BudgetOverviewView
                    Icon="M5 3v18l3-2 2 2 2-2 2 2 2-2 3 2V3l-3 2-2-2-2 2-2-2-2 2-3-2zM8 9h8M8 13h8"
                    HeaderText="Statistiques"
                    TotalLabelText="Commandes"
                    TotalValue="{Binding DashBoardCollection.statistics.orderCount}"
                    ExpensesLabelText="Articles"
                    ExpensesValue="{Binding DashBoardCollection.statistics.itemCount}"
                    RemainingLabelText="Modèles"
                    IsExpensesVisible="True"
                    RemainingValue="{Binding DashBoardCollection.statistics.modelCount}"/>
                <components:BudgetOverviewView
                    Icon="M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4"
                    HeaderText="Valeur du stock"
                    TotalLabelText="Chiffre d’affaires"
                    TotalValue="{Binding DashBoardCollection.valeurStock.stockValue, Converter={StaticResource CurrencyConverter}}"
                    ExpensesLabelText="Articles"
                    ExpensesValue="{Binding DashBoardCollection.valeurStock.stockValue, Converter={StaticResource CurrencyConverter}}"
                    RemainingLabelText="Marge"
                    IsExpensesVisible="False"
                    RemainingValue="{Binding DashBoardCollection.valeurStock.marge, Converter={StaticResource CurrencyConverter}}"/>
                <components:BudgetOverviewView
                    Icon="M19 5L5 19M6.5 9a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM17.5 20a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"
                    HeaderText="Taux de marge"
                    TotalLabelText="Taux de marge"
                    TotalValue="{Binding DashBoardCollection.tauxMarge.tauxMarge, Converter={StaticResource PercentageConverter}}"
                    ExpensesLabelText="Articles"
                    ExpensesValue="{Binding DashBoardCollection.tauxMarge.tauxMarge, Converter={StaticResource PercentageConverter}}"
                    RemainingLabelText="Taux de marque"
                    IsExpensesVisible="False"
                    RemainingValue="{Binding DashBoardCollection.tauxMarge.tauxMarque, Converter={StaticResource PercentageConverter}}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
