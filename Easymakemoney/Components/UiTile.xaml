<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Easymakemoney.Components"
             x:Class="Easymakemoney.Components.UiTile">
    <components:UiCard x:Name="Card" Style="{StaticResource UiCard}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    BackgroundColor="{DynamicResource ThemePrimaryTint}">
                <Path x:Name="IconPath" Style="{StaticResource UiIcon}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label x:Name="TitleLabel" Style="{StaticResource UiTitle}" />
                <Label x:Name="TextLabel" Style="{StaticResource UiBody}" />
            </VerticalStackLayout>
            <Path Grid.Column="2" Data="M9 6l6 6-6 6" Stroke="{StaticResource UiTextMuted}" StrokeThickness="2" StrokeLineCap="Round"
                  StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24" Aspect="None" VerticalOptions="Center" />
        </Grid>
    </components:UiCard>
</ContentView>
