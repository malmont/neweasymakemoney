<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Easymakemoney.Components"
             x:Class="Easymakemoney.Components.BudgetOverviewWhithOutHedearView">

       <ContentView.Content>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                     <Grid.Triggers>
                            <DataTrigger TargetType="Grid"
                                         Binding="{Binding IsExpensesVisible, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                         Value="False">
                                   <Setter Property="RowSpacing" Value="0"/>
                            </DataTrigger>
                     </Grid.Triggers>
              <local:UiCard Style="{StaticResource UiCard}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                     <local:UiCard.Triggers>
                            <DataTrigger TargetType="local:UiCard"
                                         Binding="{Binding IsExpensesVisible, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                         Value="False">
                                   <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                     </local:UiCard.Triggers>
                     <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalLabelText, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                   Style="{StaticResource UiBody}"/>
                            <Label Text="{Binding TotalValue, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                   FontFamily="InterBold"
                                   FontSize="22"
                                   TextColor="{DynamicResource ThemePrimary}"/>
                     </VerticalStackLayout>
              </local:UiCard>
              <local:UiCard Style="{StaticResource UiCard}" Grid.Row="1" Grid.Column="0" IsVisible="{Binding IsExpensesVisible, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}">
                     <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ExpensesLabelText, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                   Style="{StaticResource UiBody}"/>
                            <Label Text="{Binding ExpensesValue, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                   FontFamily="InterBold"
                                   FontSize="22"
                                   TextColor="{StaticResource UiTextPrimary}"/>
                     </VerticalStackLayout>
              </local:UiCard>
              <local:UiCard Style="{StaticResource UiCard}" Grid.Row="1" Grid.Column="1">
                     <local:UiCard.Triggers>
                            <DataTrigger TargetType="local:UiCard"
                                         Binding="{Binding IsExpensesVisible, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                         Value="False">
                                   <Setter Property="Grid.Row" Value="0"/>
                            </DataTrigger>
                     </local:UiCard.Triggers>
                     <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding RemainingLabelText, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                   Style="{StaticResource UiBody}"/>
                            <Label Text="{Binding RemainingValue, Source={RelativeSource AncestorType={x:Type local:BudgetOverviewWhithOutHedearView}}}"
                                   FontFamily="InterBold"
                                   FontSize="22"
                                   TextColor="{StaticResource UiTextPrimary}"/>
                     </VerticalStackLayout>
              </local:UiCard>
              </Grid>
       </ContentView.Content>
</ContentView>
