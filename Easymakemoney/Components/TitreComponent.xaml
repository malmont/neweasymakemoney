<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Easymakemoney.Components"
             x:Class="Easymakemoney.Components.TitreComponent">

    <!-- Avec valeur : tuile blanche. Sans valeur : simple titre de section. -->
    <local:UiCard Style="{StaticResource UiCard}">
        <local:UiCard.Triggers>
            <DataTrigger TargetType="local:UiCard"
                         Binding="{Binding IsExpensesVisible, Source={RelativeSource AncestorType={x:Type local:TitreComponent}}}"
                         Value="False">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </DataTrigger>
        </local:UiCard.Triggers>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Image Source="{Binding IconSource, Source={RelativeSource AncestorType={x:Type local:TitreComponent}}}"
                   WidthRequest="24"
                   HeightRequest="24"
                   VerticalOptions="Center"/>

            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="{Binding HeaderText, Source={RelativeSource AncestorType={x:Type local:TitreComponent}}}"
                       Style="{StaticResource UiBody}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsExpensesVisible, Source={RelativeSource AncestorType={x:Type local:TitreComponent}}}"
                                     Value="False">
                            <Setter Property="FontFamily" Value="InterSemiBold"/>
                            <Setter Property="FontSize" Value="17"/>
                            <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label IsVisible="{Binding IsExpensesVisible, Source={RelativeSource AncestorType={x:Type local:TitreComponent}}}"
                       Text="{Binding Value, Source={RelativeSource AncestorType={x:Type local:TitreComponent}}}"
                       FontFamily="InterBold"
                       FontSize="22"
                       TextColor="{StaticResource UiTextPrimary}"/>
            </VerticalStackLayout>
        </Grid>
    </local:UiCard>

</ContentView>
