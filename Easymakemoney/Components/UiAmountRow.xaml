<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Easymakemoney.Components.UiAmountRow">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
        <BoxView x:Name="Separator" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource UiBorder}" IsVisible="False" />
        <Label x:Name="TitleLabel" Grid.Row="1" Style="{StaticResource UiBody}" FontSize="14" />
        <Label x:Name="ValueLabel" Grid.Row="1" Grid.Column="1" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource UiTextPrimary}" />
    </Grid>
</ContentView>
