<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Easymakemoney.Components.UiThumb"
             WidthRequest="48"
             HeightRequest="48"
             VerticalOptions="Center">
    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="{DynamicResource ThemePrimaryTint}">
        <Grid>
            <Path x:Name="IconPath" Style="{StaticResource UiIcon}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Image x:Name="ThumbImage" Aspect="AspectFill" />
        </Grid>
    </Border>
</ContentView>
