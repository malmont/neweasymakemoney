<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Easymakemoney.Components.AppHeader">
    <VerticalStackLayout x:Name="HeaderRoot" BackgroundColor="{StaticResource UiSurface}">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" Padding="16,10,16,12">
            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource UiSurface}"
                    Stroke="{StaticResource UiBorder}" StrokeShape="RoundRectangle 12"
                    SemanticProperties.Description="{Binding NavigationDescription}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavigationTapped" />
                </Border.GestureRecognizers>
                <Grid>
                    <Path IsVisible="{Binding IsRoot}" Data="M4 7h16M4 12h16M4 17h16" Stroke="{StaticResource UiTextPrimary}" StrokeThickness="2"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24" Aspect="None"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Path IsVisible="{Binding IsSubPage}" Data="M15 6l-6 6 6 6" Stroke="{StaticResource UiTextPrimary}" StrokeThickness="2"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24" Aspect="None"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="1" IsVisible="{Binding IsRoot}" WidthRequest="44" HeightRequest="44"
                    BackgroundColor="{DynamicResource ThemePrimaryTint}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Grid>
                    <Label Text="{Binding Branding.Initial}" IsVisible="{Binding Branding.HasNoLogo}" FontFamily="InterBold" FontSize="18"
                           TextColor="{DynamicResource ThemePrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid IsVisible="{Binding Branding.HasLogo}" BackgroundColor="{StaticResource UiSurface}" Padding="3">
                        <Image Source="{Binding Branding.LogoUrl}" Aspect="AspectFit" />
                    </Grid>
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1" IsVisible="{Binding IsRoot}">
                <Label Text="{Binding Branding.SiteName}" Style="{StaticResource UiTitle}" FontSize="16" LineBreakMode="TailTruncation" />
                <Label Text="Gestion" Style="{StaticResource UiBody}" />
            </VerticalStackLayout>

            <Label Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding IsSubPage}" Text="{Binding Title}"
                   FontFamily="InterBold" FontSize="20" TextColor="{StaticResource UiTextPrimary}"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
        </Grid>
        <BoxView HeightRequest="1" Color="{StaticResource UiBorder}" />
    </VerticalStackLayout>
</ContentView>
