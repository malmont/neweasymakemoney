<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Easymakemoney.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:startupPages="clr-namespace:Easymakemoney.Views.Startup"
    xmlns:DashboardPages="clr-namespace:Easymakemoney.Views.Dasboard"
    xmlns:Models="clr-namespace:Easymakemoney.Models"
    xmlns:views="clr-namespace:Easymakemoney.Views.Dasboard"
    Shell.TabBarIsVisible="False"
    FlyoutBackgroundColor="{StaticResource UiSurface}"
    xmlns:local="clr-namespace:Easymakemoney">

     <ShellContent FlyoutItemIsVisible="False" Shell.FlyoutBehavior="Disabled"
        ContentTemplate="{DataTemplate startupPages:LoadingPage}"
        Route="LoadingPage" />

     <ShellContent FlyoutItemIsVisible="False" Shell.FlyoutBehavior="Disabled"
        ContentTemplate="{DataTemplate startupPages:ActivationPage}"
        Route="ActivationPage" />

     <ShellContent Title="Login Page" FlyoutItemIsVisible="False" Shell.FlyoutBehavior="Disabled"
        ContentTemplate="{DataTemplate startupPages:LoginPage}"
        Route="LoginPage" />

     <ShellContent Title="Code OTP" FlyoutItemIsVisible="False" Shell.FlyoutBehavior="Disabled"
        ContentTemplate="{DataTemplate startupPages:OtpPage}"
        Route="OtpPage" />
   

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems" Route="DashboardPage">

            <ShellContent
            Title="Accueil" Icon="{x:Static Models:Icons.Dashboard}"
            ContentTemplate="{DataTemplate DashboardPages:DashboardPage}"/>
          <ShellContent
            Title="Contact" Icon="{x:Static Models:Icons.ContactUs}"
            ContentTemplate="{DataTemplate DashboardPages:DashboardPage}"/>
         <ShellContent
            Title="À propos" Icon="{x:Static Models:Icons.AboutUs}"
            ContentTemplate="{DataTemplate DashboardPages:DashboardPage}"/>

         <ShellContent
            Title="Équipe" Icon="{x:Static Models:Icons.People}"
            ContentTemplate="{DataTemplate DashboardPages:DashboardPage}"/>

     </FlyoutItem>
  


    <Shell.FlyoutFooter >
        <VerticalStackLayout Padding="16,8,16,20" Spacing="2" BackgroundColor="{StaticResource UiSurface}">
            <BoxView HeightRequest="1" Color="{StaticResource UiBorder}" Margin="0,0,0,8" />
            <Button Text="Changer de site" Command="{Binding ChangeSiteCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource ThemePrimary}" FontFamily="InterMedium" FontSize="15" MinimumHeightRequest="44" />
            <Button Text="Se déconnecter" Command="{Binding SignOutCommand}" BackgroundColor="Transparent" TextColor="#B91C1C" FontFamily="InterMedium" FontSize="15" MinimumHeightRequest="44" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>

