<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                    xmlns:local="clr-namespace:Easymakemoney.Models"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Liste de sélection générique -->
    <ControlTemplate x:Key="CollectionFormListViewTemplate">
        <StackLayout>
            <ScrollView>
                <StackLayout Spacing="0">
                    <!-- Utilisation de Items au lieu de ListCollections -->
                    <CollectionView ItemsSource="{Binding Items}" HeightRequest="500" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <!-- Utilisation d'un IListItem générique -->
                            <DataTemplate x:DataType="local:IListItem">
                                <Grid Padding="0,0,0,10">
                                    <Border BackgroundColor="{StaticResource UiSurface}"
                                            Stroke="{StaticResource UiBorder}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Margin="10"
                                                    WidthRequest="52"
                                                    HeightRequest="52"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{StaticResource UiBackground}">
                                                <Image Aspect="AspectFill"
                                                       Source="{Binding Photo}">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedCommand, Source={RelativeSource AncestorType={x:Type toolkit:Popup}}}"
                                                                              CommandParameter="{Binding .}"/>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Border>
                                            <Label Grid.Column="1"
                                                   Padding="2,0,12,0"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation"
                                                   FontFamily="InterMedium"
                                                   FontSize="15"
                                                   TextColor="{StaticResource UiTextPrimary}"
                                                   Text="{Binding Name}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedCommand, Source={RelativeSource AncestorType={x:Type toolkit:Popup}}}"
                                                                          CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </ScrollView>
        </StackLayout>
    </ControlTemplate>

</ResourceDictionary>
