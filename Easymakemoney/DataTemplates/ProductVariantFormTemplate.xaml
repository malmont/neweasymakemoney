<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:controls="clr-namespace:Easymakemoney.Controls"
                    xmlns:handlers="clr-namespace:Easymakemoney.Handlers">

    <Style x:Key="FormLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource UiTextSecondary}" />
    </Style>
    <Style x:Key="FormField" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource UiSurface}" />
        <Setter Property="Stroke" Value="{StaticResource UiBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="FormEntry" TargetType="handlers:BorderlessEntry">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource UiTextMuted}" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>
    <Style x:Key="FormPicker" TargetType="Picker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource UiTextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource UiTextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <!-- Formulaire de variante de produit -->
    <ControlTemplate x:Key="ProductVariantFormTemplate">
        <VerticalStackLayout Spacing="12">
            <VerticalStackLayout Spacing="6">
                <Label Text="Couleur" Style="{StaticResource FormLabel}" />
                <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                    <Picker Style="{StaticResource FormPicker}"
                            Title="Sélectionner une couleur"
                            ItemsSource="{Binding ProductVariantForm.Colors}"
                            SelectedItem="{Binding ProductVariantForm.SelectedColor}"
                            ItemDisplayBinding="{Binding name}" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="Taille" Style="{StaticResource FormLabel}" />
                <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                    <Picker Style="{StaticResource FormPicker}"
                            Title="Sélectionner une taille"
                            ItemsSource="{Binding ProductVariantForm.Sizes}"
                            SelectedItem="{Binding ProductVariantForm.SelectedSize}"
                            ItemDisplayBinding="{Binding name}" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label Text="Quantité en stock" Style="{StaticResource FormLabel}" />
                <Border Style="{StaticResource FormField}" StrokeShape="RoundRectangle 12">
                    <handlers:BorderlessEntry Style="{StaticResource FormEntry}"
                                              Placeholder="Quantité en stock"
                                              Keyboard="Numeric"
                                              Text="{Binding ProductVariantForm.StockQuantity, Mode=TwoWay}" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ControlTemplate>
</ResourceDictionary>